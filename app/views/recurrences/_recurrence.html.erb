<article data-elevation="1"><header><%= icon(recurrence.category.icon, style: icon_colour_styles(recurrence.category.colour)) %><h2><%= link_to recurrence.name, recurrence_path(recurrence) %></h2><strong><%= formatted_amount(recurrence.amount, recurrence.currency_code) %> <%= recurrence.currency_code %></strong></header><main><p><%= recurrence.category.name %></p><p><%= t(".schedule", date: l(recurrence.occurs_on, format: :long), days: recurrence.occurrence_period_in_days) %></p></main><footer><%= link_to t(".record"), new_budget_expense_path(recurrence.budget, recurrence_id: recurrence.id), role: "button", data: { intent: "primary" } %></footer></article>
