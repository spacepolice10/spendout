<main data-size="sm"><article data-elevation="1"><header><%= icon(@recurrence.category.icon, style: icon_colour_styles(@recurrence.category.colour)) %><h1><%= @recurrence.name %></h1></header><main><p><%= @recurrence.category.name %></p><p><%= formatted_amount(@recurrence.amount, @recurrence.currency_code) %> <%= @recurrence.currency_code %></p><p><%= l(@recurrence.occurs_on, format: :long) %></p></main><footer><%= link_to t(".record"), new_budget_expense_path(@budget, recurrence_id: @recurrence.id), role: "button", data: { intent: "primary" } %><%= link_to t(".edit"), edit_recurrence_path(@recurrence), role: "button", data: { intent: "secondary" } %><%= button_to t(".finish"), finish_recurrence_path(@recurrence), method: :patch, data: { intent: "negative", turbo_confirm: t(".finish_confirmation") } %></footer></article></main>
