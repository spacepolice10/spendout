<% unless page.only? %>
  <footer>
    <nav aria-label="<%= t(".name", records: records_name) %>">
      <% unless page.first? %>
        <%= link_to t(".previous"), url_for(page: page.number - 1), role: "button", data: { intent: "secondary" } %>
      <% end %>

      <span><%= t(".position", page: page.number, pages: page.recordset.page_count) %></span>

      <% unless page.last? %>
        <%= link_to t(".next"), url_for(page: page.next_param), role: "button", data: { intent: "secondary" } %>
      <% end %>
    </nav>
  </footer>
<% end %>
