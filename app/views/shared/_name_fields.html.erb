<%# locals: (form:, name_attribute: :name, placeholder: nil, open: true, input_data: {}) %>
<%= tag.details name: "form-details", data: { form_target: "section" }, open: open do %>
  <%= tag.summary data: { form_target: "summary" } do %>
    <%= tag.span " Name: " %>

    <%= tag.small data: { form_target: "summaryContent" } do %>
      <%= form.object.public_send(name_attribute) %>
    <% end %>
  <% end %>

  <%= tag.div do %>
    <%= tag.small do %>
      What is the name of this <%= form.object.class.name.downcase %>?
    <% end %>

    <%= form.label name_attribute, "Name", class: "utilities--sr-only" %>

    <%= form.text_field name_attribute, required: true, placeholder: placeholder,
      autofocus: open && !mobile_variant?,
      data: input_data.merge({
        form_target: "focus",
        action: "input->form#updateSummary"
      }) { |_key, original, extra| [ original, extra ].compact.join(" ") } %>

    <% unless mobile_variant? %>
      <%= tag.small do %>
        Press <%= tag.kbd "Enter" %> to continue or <%= tag.kbd "Shift" %> +
        <%= tag.kbd "Enter" %> to go back.
      <% end %>
    <% end %>
  <% end %>
<% end %>
