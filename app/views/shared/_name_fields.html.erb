<%# locals: (form:, name_attribute: :name, placeholder: nil, open: true, required: true, input_data: {}) %>
<section>
    <%= form.label name_attribute, data: { name_field: true } do %>
      <span><%= t(".name") %></span>

      <%= form.text_field name_attribute, required: required, placeholder: placeholder,
        autofocus: open && !mobile_variant?, data: input_data %>
    <% end %>
</section>
