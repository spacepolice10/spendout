<nav aria-label="<%= t(".name") %>" data-pill-group>
  <%= button_to t(".english"), locale_path, method: :patch, params: { locale: "en" },
        disabled: current_locale == :en, aria: { pressed: current_locale == :en }, data: { intent: "secondary" } %>
  <%= button_to t(".russian"), locale_path, method: :patch, params: { locale: "ru" },
        disabled: current_locale == :ru, aria: { pressed: current_locale == :ru }, data: { intent: "secondary" } %>
</nav>
