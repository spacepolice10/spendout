<header data-landing-header>
  <details data-landing-header-mobile>
    <summary>
      <span>
        <img src="/icon-32.png" alt="" width="32" height="32">
        <span>Spendout</span>
        <%= icon("chevron-right") %>
      </span>
    </summary>

    <div>
      <nav aria-label="Product">
        <%= link_to "Features", landing_path(anchor: "details") %>
        <%= link_to "Tour", tour_path(feature: Tour::FEATURES.keys.first) %>
        <a href="<%= once_path %>" data-once-mark>
          <%= icon("brand-once") %>
          <span>ONCE</span>
        </a>
        <%= link_to authenticated? ? "Open my budget" : "Try Spendout", authenticated? ? root_path : new_session_path %>
        <%= link_to "https://github.com/spacepolice10/spendout" do %>
          <%= icon("brand-github") %>
          <span>GitHub</span>
        <% end %>
      </nav>
    </div>
  </details>
</header>
