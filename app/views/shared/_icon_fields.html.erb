<%# locals: (form:, open: false, input_data: {}) %>
<details name="form-details" data-form-target="section"<%= " open" if open %>>
  <summary data-form-target="summary">
    <span> Icon: </span>
    <small data-form-target="summaryContent"><%= form.object.icon %></small>
  </summary>

  <fieldset data-layout="flex">
    <legend class="utilities--sr-only">Icon</legend>
    <div>
      <%= form.collection_radio_buttons :icon, form.object.class.icon_options, :second, :first do |radio| %>
        <%= radio.label title: radio.text do %>
          <%= radio.radio_button aria: { label: radio.text }, data: input_data.merge({
                form_target: "focus",
                action: "input->form#updateSummary"
              }) { |_key, original, extra| [ original, extra ].compact.join(" ") } %>
          <%= icon(radio.value) %>
        <% end %>
      <% end %>
    </div>
    <% unless mobile_variant? %>
      <small>
        Use <kbd>arrow keys</kbd> to switch.
      </small>
      <small>
        Press <kbd>Enter</kbd> to continue or <kbd>Shift</kbd> + <kbd>Enter</kbd> to go back.
      </small>
    <% end %>
  </fieldset>
</details>
