<% if (budget = Current.user&.current_budget) %>
  <nav aria-label="Add">
    <div>
      <%= link_to new_budget_income_path(budget), role: "button", data: { intent: "primary", quick_add: "income" } do %>
        <%= icon("arrow-down") %>
        <span><%= t("features.income") %></span>
      <% end %>
      <%= link_to new_budget_expense_path(budget), role: "button", data: { intent: "primary", quick_add: "expense" } do %>
        <%= icon("arrow-up") %>
        <span><%= t("features.expense") %></span>
      <% end %>
    </div>
  </nav>
<% end %>
