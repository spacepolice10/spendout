<%# locals: (form:, open: false) %>
<details name="form-details" data-form-target="section"<%= " open" if open %>>
  <summary data-form-target="summary">
    <span> Colour: </span>
    <small data-form-target="summaryContent"><%= form.object.colour %></small>
  </summary>

  <fieldset data-layout="flex">
    <legend class="utilities--sr-only">Colour</legend>
    <div>
      <%= form.collection_radio_buttons :colour, form.object.class.colour_options, :second, :first do |radio| %>
        <%= radio.label title: radio.text, style: "--form-checked-background: var(--color-palette-#{radio.value}); --form-checked-color: var(--color-invert-1);" do %>
          <%= radio.radio_button aria: { label: radio.text }, data: {
                form_target: "focus",
                action: "input->form#updateSummary"
              } %>
          <%= icon_tag("circle-dot", style: "color: var(--color-palette-#{radio.value});") %>
        <% end %>
      <% end %>
    </div>
    <% unless mobile_variant? %>
      <small>
        Use <kbd>arrow keys</kbd> to switch.
      </small>
      <small>
        Press <kbd>Shift</kbd> + <kbd>Enter</kbd> to go back.
      </small>
    <% end %>
  </fieldset>
</details>
