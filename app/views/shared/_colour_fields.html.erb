<%# locals: (form:, open: false, input_data: {}, colour_attribute: :colour, colour_options: form.object.class.colour_options, colour_value: form.object.public_send(colour_attribute)) %>
<details name="form-details" data-form-target="section"<%= " open" if open %>>
  <summary>
    <span><%= t(".name") %>:</span>
    <small data-form-target="summaryContent"><%= colour_value %></small>
  </summary>

  <fieldset data-layout="flex">
    <legend class="utilities--sr-only"><%= t(".name") %></legend>
    <div>
      <%= form.collection_radio_buttons colour_attribute, colour_options, :second, :first do |radio| %>
        <%= radio.label title: radio.text, style: "--form-checked-background: var(--color-palette-#{radio.value}); --form-checked-color: var(--color-invert-1);" do %>
          <%= radio.radio_button aria: { label: radio.text }, data: input_data %>
          <%= icon("circle-dot", style: "color: var(--color-palette-#{radio.value});") %>
        <% end %>
      <% end %>
    </div>
    <% unless mobile_variant? %>
      <small>
        <%= t(".arrows_navigation_html", arrows: tag.kbd("arrow keys")) %>
      </small>
    <% end %>
  </fieldset>
</details>
