<%# locals: (form:, attribute:, filter_data: {}, filter_autofocus: false, preferred_currencies: []) %>
<% selected_code = form.object.public_send(attribute) %>
<% suggested_code = Current.suggested_currency_code %>
<% ordered_options = Currency.options_prioritizing([
     selected_code, suggested_code, *preferred_currencies, *Currency::POPULAR_CURRENCIES
   ]) %>
<div class="currency-picker" data-controller="currency-picker"
  data-currency-picker-autofocus-value="<%= filter_autofocus && !mobile_variant? %>">
  <%= form.select attribute, Currency.options, { include_blank: "Choose a currency" }, required: true,
    class: "utilities--sr-only", aria: { label: "Currency" },
    data: { currency_picker_target: "select", currency_fields_target: "currency",
      expense_fields_target: "currency" } %>

  <button type="button" aria-haspopup="dialog" aria-controls="currency-picker-dialog"
    data-currency-picker-target="currencyTrigger" data-action="currency-picker#openCurrency">
    <span data-currency-picker-target="selection"><%= Currency.options.to_h.invert[selected_code] || "Choose a currency" %></span>
    <%= icon("chevron-right", aria: { hidden: true }) %>
  </button>

  <dialog id="currency-picker-dialog" aria-label="Choose a currency"
    data-currency-picker-target="currencyDialog"
    data-action="close->currency-picker#currencyHidden">
    <header>
      <h2>Choose a currency</h2>
      <button type="button" aria-label="Close currency picker" data-action="currency-picker#hideCurrency">&times;</button>
    </header>
    <div data-currency-combobox>
      <%= icon("search", data: { currency_search_icon: true }) %>
      <input type="search" placeholder="Search by name or code" autocomplete="off" role="combobox"
        <%= "autofocus" if filter_autofocus && !mobile_variant? %>
        aria-label="Search currencies" aria-autocomplete="list" aria-expanded="true"
        aria-controls="currency-picker-listbox" data-currency-picker-target="filter"
        data-action="input->currency-picker#search keydown->currency-picker#keydown"
        <% filter_data.each do |name, value| %> data-<%= name.to_s.dasherize %>="<%= value %>"<% end %>>
    </div>
    <div id="currency-picker-listbox" role="listbox" data-currency-picker-target="options">
      <% ordered_options.each do |label, code| %>
        <div data-currency-picker-option>
          <label id="<%= form.field_id(attribute, "option_#{code.downcase}") %>" role="option"
            aria-selected="<%= code == selected_code %>" data-currency-picker-target="option"
            data-filter-value="<%= label %>"
            <% if Currency::POPULAR_CURRENCIES.include?(code) %>data-popular="true"<% end %>
            <% if code == selected_code %>data-default="true"<% end %>
            <% if code == suggested_code %>data-suggested="true"<% end %>>
            <input type="radio" name="<%= form.object_name %>-currency-picker" value="<%= code %>"
              <%= "checked" if code == selected_code %>
              data-action="change->currency-picker#choose">
            <span><%= label %></span>
          </label>
        </div>
      <% end %>
    </div>
    <small data-currency-picker-target="emptyState" hidden>No currencies found</small>
  </dialog>
</div>
