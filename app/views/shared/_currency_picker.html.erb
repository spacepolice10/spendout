<%# locals: (form:, attribute:, select_data: {}, filter_autofocus: false) %>
<div data-controller="currency-picker">
  <%= form.select attribute,
    Currency.options,
    { include_blank: "Choose a currency" }, required: true,
    class: "utilities--sr-only",
    aria: { label: "Currency" },
    data: { currency_picker_target: "select" }.merge(select_data) %>

  <%= tag.input type: "search", placeholder: "Search by name or code",
    autocomplete: "off",
    autofocus: filter_autofocus,
    aria: { label: "Search currencies" },
    data: {
      currency_picker_target: "filter",
      action: "input->currency-picker#filter"
    } %>

  <div data-layout="grid" data-currency-picker-target="options">
    <% Currency.options.each do |label, code| %>
      <% popular = Currency::POPULAR_CODES.include?(code) %>
      <button type="button" value="<%= code %>" data-intent="secondary"
        data-filter-value="<%= label %>"
        data-currency-picker-target="option"
        <% if popular %> data-popular="true"<% else %> hidden<% end %>
        data-action="click->currency-picker#choose"><%= label %></button>
    <% end %>
  </div>

  <small data-currency-picker-target="emptyState" hidden> No currencies found </small>
</div>
