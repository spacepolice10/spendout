<%# locals: (form:, question:, currency_attribute:, rate_attribute:, base_currency_code:, amount_attribute: :amount, amount_label: nil, open: false, disclosure: true, default_amount: false, minimum: "0", minimum_exclusive: false, preferred_currencies: []) %>
<% amount = form.object.public_send(amount_attribute) %>
<% currency_code = form.object.public_send(currency_attribute).presence || base_currency_code %>
<% amount_label ||= t("shared.amount_currency_fields.name") %>
<% controls_locals = { form:, question:, currency_attribute:, rate_attribute:, base_currency_code:,
     amount_attribute:, amount_label:, open:, default_amount:, minimum:, minimum_exclusive:,
     preferred_currencies:, amount:, currency_code: } %>
<% if disclosure %>
  <%= tag.details name: "form-details", open: open,
        data: { form_target: "section", amount_currency_section: true } do %>
    <summary data-form-target="summary">
      <span><%= amount_label %></span>
      <small data-form-target="summaryContent">
        <span data-form-summary-content="amount"><%= number_with_delimiter(amount || 0, delimiter: ".", separator: ",") %></span>
        <span data-form-summary-content="currency"><%= currency_code %></span>
      </small>
    </summary>
    <%= render "shared/amount_currency_controls", **controls_locals %>
  <% end %>
<% else %>
  <section data-amount-currency-section data-form-target="section">
    <header><%= amount_label %></header>
    <%= render "shared/amount_currency_controls", **controls_locals %>
  </section>
<% end %>
