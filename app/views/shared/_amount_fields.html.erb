<%# locals: (form:, question:, amount_attribute: :amount, open: false, default_amount: false, minimum: "0", minimum_exclusive: false) %>
<% amount = form.object.public_send(amount_attribute) %>
<details name="form-details" data-form-target="section"<%= " open" if open %>>
  <summary data-form-target="summary">
    <span><%= t(".name") %></span>
    <small data-form-target="summaryContent"><%= number_with_delimiter(amount || 0, delimiter: ".", separator: ",") %></small>
  </summary>

  <div>
    <small><%= question %></small>

    <%= form.label amount_attribute, t(".name"), class: "utilities--sr-only" %>
    <%= form.text_field amount_attribute, inputmode: "decimal", placeholder: "0",
      autofocus: open && !mobile_variant?, required: true,
      value: default_amount ? amount || 0 : amount,
      data: {
        controller: "amount-fields",
        form_target: "toBeFocused",
        amount_fields_start_value: amount ? amount.to_s("F") : (default_amount ? "0" : nil),
        amount_fields_minimum_value: minimum,
        amount_fields_minimum_exclusive_value: minimum_exclusive,
        currency_fields_target: "amount",
        action: "input->currency-fields#calculate"
      } %>
    <% unless mobile_variant? %>
      <small>
        <%= t("shared.form_navigation.continue_html", enter: tag.kbd("Enter"), shift: tag.kbd("Shift")) %>
      </small>
    <% end %>
  </div>
</details>
