<%# locals: (form:, amount_attribute: :amount, open: false, default_amount: false) %>
<% amount = form.object.public_send(amount_attribute) %>
<details name="form-details" data-controller="form-details"<%= " open" if open %>>
  <summary data-form-details-target="summary">
    <span> Amount: </span>
    <small data-form-details-target="summaryContent"><%= amount || 0 %></small>
  </summary>

  <div>
    <small> How much money is in this <%= form.object.class.name.downcase %>? </small>

    <%= form.label amount_attribute, "Amount", class: "utilities--sr-only" %>
    <%= form.text_field amount_attribute, inputmode: "decimal", placeholder: "0", autofocus: open, required: true,
      value: default_amount ? amount || 0 : amount,
      data: {
        controller: "money-input",
        form_details_target: "input",
        money_input_start_value: amount ? amount.to_s("F") : (default_amount ? "0" : nil),
        currency_conversion_target: "amount",
        action: "input->currency-conversion#calculate input->form-details#updateSummaryContent"
      } %>
    <% unless mobile_variant? %>
      <small>
        Press <kbd>Enter</kbd> to continue or <kbd>Shift</kbd> + <kbd>Enter</kbd> to go back.
      </small>
    <% end %>
  </div>
</details>
