<%# locals: (form:, currency_attribute:, rate_attribute:, base_currency_code:, open: false) %>
<% currency_code = form.object.public_send(currency_attribute).presence || base_currency_code %>
<details name="form-details" data-controller="form-details"<%= " open" if open %>>
  <summary data-form-details-target="summary">
    <span> Currency: </span>
    <small data-form-details-target="summaryContent"><%= currency_code %></small>
  </summary>

  <div>
    <small> What currency is used? </small>
    <%= form.label currency_attribute, "Currency", class: "utilities--sr-only" %>

    <%= render "shared/currency_picker", form: form, attribute: currency_attribute,
          select_data: {
            currency_conversion_target: "currency",
            action: "change->currency-conversion#currencyChanged input->form-details#updateSummaryContent"
          },
          filter_data: { form_details_target: "input" },
          rate_attribute: rate_attribute,
          base_currency_code: base_currency_code %>
    <small>
      Use <kbd>arrow keys</kbd> to switch.
    </small>

    <small>
      Press <kbd>Enter</kbd> to continue or <kbd>Shift</kbd> + <kbd>Enter</kbd> to go back.
    </small>
  </div>
</details>
