<%# locals: (form:, currency_attribute:, rate_attribute:, base_currency_code:, open: false, preferred_currencies: []) %>
<% currency_code = form.object.public_send(currency_attribute).presence || base_currency_code %>
<details name="form-details" data-form-target="section"<%= " open" if open %>>
  <summary data-form-target="summary">
    <span><%= t(".name") %></span>
    <small data-form-target="summaryContent"><%= currency_code %></small>
  </summary>

  <div data-currency-fields>
    <small><%= t(".question") %></small>
    <%= form.label currency_attribute, t(".name"), class: "utilities--sr-only" %>

    <%= render "shared/currency_picker", form: form, attribute: currency_attribute,
          filter_data: { form_target: "toBeFocused" },
          preferred_currencies: preferred_currencies %>
    <%= render "shared/currency_rate_picker", form: form, attribute: rate_attribute,
          currency_code: currency_code, base_currency_code: base_currency_code %>
    <% unless mobile_variant? %>
      <small>
        <%= t(".arrows_navigation_html", arrows: tag.kbd("arrow keys")) %>
      </small>

      <small>
        <%= t("shared.form_navigation.continue_html", enter: tag.kbd("Enter"), shift: tag.kbd("Shift")) %>
      </small>
    <% end %>
  </div>
</details>
