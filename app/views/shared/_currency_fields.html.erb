<details name="form-details" data-controller="form-details">
  <summary data-form-details-target="summary">
    <span> Currency: </span>
    <small data-form-details-target="summaryContent"><%= base_currency_code %></small>
  </summary>

  <div>
    <small> What currency is used? </small>
    <%= form.label currency_attribute, "Currency", hidden: true %>

    <%= render "shared/currency_picker", form: form, attribute: currency_attribute,
          select_data: {
            currency_conversion_target: "currency",
            action: "change->currency-conversion#currencyChanged input->form-details#updateSummaryContent"
          } %>

    <% base_id = "#{form.object_name}_#{rate_attribute}_base" %>
    <% quote_id = "#{form.object_name}_#{rate_attribute}_quote" %>

    <%= tag.div data: { currency_conversion_target: "rateFields" },
            hidden: form.object.public_send(currency_attribute).blank? ||
              form.object.public_send(currency_attribute) == base_currency_code do %>
      <%= form.hidden_field rate_attribute, data: { currency_conversion_target: "rate" } %>

      <small id="currency-rate-help">
        Enter equivalent amounts or swap sides.
      </small>

      <div data-layout="flex" style="align-items: end;">
        <div>
          <input type="text" id="<%= base_id %>" inputmode="decimal" value="1"
            aria-label="Amount in <%= base_currency_code %>"
            data-controller="money-input"
            data-money-input-fraction-digits-value="12"
            data-currency-conversion-target="rateBase"
            data-action="input->currency-conversion#calculateFromBase">

          <small><%= base_currency_code %></small>
        </div>

        <button type="button" aria-label="Swap currencies"
          data-action="currency-conversion#swapPair">
          <svg viewBox="0 0 16 16" width="1em" height="1em" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M2 5h10l-3-3M14 11H4l3 3"></path>
          </svg>
        </button>

        <div>
          <input type="text" id="<%= quote_id %>" inputmode="decimal"
            value="<%= form.object.public_send(rate_attribute)&.to_s("F") %>"
            aria-label="Amount in selected currency"
            data-controller="money-input"
            data-money-input-fraction-digits-value="12"
            data-currency-conversion-target="rateQuote"
            data-action="input->currency-conversion#calculateFromQuote">

          <small data-currency-conversion-target="rateCode">
            <%= form.object.public_send(currency_attribute) %>
          </small>
        </div>
      </div>

      <small
        data-currency-conversion-target="result"
        aria-live="polite"
        hidden
      ></small>
    <% end %>
  </div>
</details>
