<%# locals: (form:, currency_attribute:, rate_attribute:, base_currency_code:, open: false, converted_amount_label: nil) %>
<% currency_code = form.object.public_send(currency_attribute).presence || base_currency_code %>
<details name="form-details" data-form-target="section"<%= " open" if open %>>
  <summary data-form-target="summary">
    <span> Currency: </span>
    <small data-form-target="summaryContent"><%= currency_code %></small>
  </summary>

  <div>
    <small> What currency is used? </small>
    <%= form.label currency_attribute, "Currency", class: "utilities--sr-only" %>

    <%= render "shared/currency_picker", form: form, attribute: currency_attribute,
          select_data: {
            currency_fields_target: "currency",
            action: "change->currency-fields#currencyChanged input->form#updateSummary"
          },
          filter_data: { form_target: "focus" },
          rate_attribute: rate_attribute,
          base_currency_code: base_currency_code,
          converted_amount_label: converted_amount_label %>
    <% unless mobile_variant? %>
      <small>
        Use <kbd>arrow keys</kbd> to switch.
      </small>

      <small>
        Press <kbd>Enter</kbd> to continue or <kbd>Shift</kbd> + <kbd>Enter</kbd> to go back.
      </small>
    <% end %>
  </div>
</details>
