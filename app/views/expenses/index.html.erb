<% content_for :title, "Expenses" %>

<main data-size="lg" data-anchor="footer">
  <article
    data-elevation="1"
    class="budget"
    data-archived="<%= @budget.archived? %>"
    data-testid="budget-card"
  >
    <main>
      <% if (todays_remainder = @budget.todays_remainder) %>
        <article data-elevation="2" data-gauge-plate>
          <h2>Can I spend more today?</h2>

          <aside data-cybercat-answer>
            <%= image_tag "cybercat.png", alt: "Cybercat", width: 40, height: 40 %>
            <p><%= cybercat_spending_answer(
              @budget.todays_remainder_percentage,
              no_expenses: @budget.expenses.none?
            ) %></p>
          </aside>

          <div data-gauge-bolts aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>

          <main>
            <%= render "shared/daily_gauge",
                    amount: todays_remainder,
                    currency_code: @budget.base_currency_code,
                    percentage: @budget.todays_remainder_percentage %>
          </main>
        </article>
      <% end %>

      <% if @expenses.any? %>
        <article
          data-elevation="1"
          class="expense-list"
          data-testid="expense-list"
        >
          <header>
            <h2>Expenses</h2>
          </header>

          <main>
            <% @expenses_by_date.each do |date, expenses| %>
              <section data-expense-day data-testid="expense-day">
                <header>
                  <h3>
                    <time datetime="<%= date.iso8601 %>"><%= date.to_fs(:long) %></time>
                  </h3>

                  <p>
                    <strong data-testid="expense-day-total">
                      <%= formatted_amount(@expense_totals_by_date.fetch(date), @budget.base_currency_code) %>
                      <%= @budget.base_currency_code %>
                    </strong>
                  </p>
                </header>

                <main>
                  <%= render expenses %>
                </main>
              </section>
            <% end %>
          </main>

          <%= render "shared/pagination", page: @page, records_name: "expenses" %>
        </article>
      <% end %>
    </main>

    <footer>
      <%= link_to new_budget_expense_path(@budget), role: "button", data: {
            appearance: "keycap",
            controller: "pressable",
            action: "keydown.shift+e@document->pressable#click"
          } do %>
        <%= icon_tag("plus") %>
        <span>Add expense</span>
        <kbd aria-hidden="true">E</kbd>
      <% end %>
    </footer>
  </article>
</main>
