<% content_for :title, "Expenses" %>

<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <article
      class="budget"
      data-archived="<%= @budget.archived? %>"
      data-testid="budget-card"
    >
      <main>
        <% if (todays_remainder = @budget.todays_remainder) %>
          <% remainder_percentage = @budget.todays_remainder_percentage.to_f.round(2) %>
          <% needle_angle = (remainder_percentage * 1.8 - 90).round(2) %>
          <article data-daily-gauge data-elevation="2">
            <header>
              <h2>Can I spend more today?</h2>
              <small>Safe to spend today: <%= formatted_amount(todays_remainder, @budget.base_currency_code) %> <%= @budget.base_currency_code %></small>
            </header>

            <main>
              <div
                role="progressbar"
                aria-label="Safe spending available today"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="<%= remainder_percentage %>"
                aria-valuetext="<%= remainder_percentage %>% of today's safe spending remains"
                data-remainder-gauge
              >
                <svg viewBox="0 0 240 150" aria-hidden="true" focusable="false">
                  <defs>
                    <linearGradient
                      id="daily-gauge-arc-colour"
                      x1="0"
                      y1="0"
                      x2="1"
                      y2="0"
                    >
                      <stop offset="0%" stop-color="var(--color-negative)" />
                      <stop offset="18%" stop-color="var(--color-4)" />
                      <stop offset="100%" stop-color="var(--color-4)" />
                    </linearGradient>
                  </defs>

                  <path
                    data-remainder-gauge-arc
                    d="M 20 118 A 100 100 0 0 1 220 118"
                  />

                  <g data-remainder-gauge-ticks>
                    <path
                      d="M 20 118 L 35 118 M 49.3 47.3 L 59.9 57.9 M 120 18 L 120 33 M 190.7 47.3 L 180.1 57.9 M 220 118 L 205 118"
                    />

                    <text x="43" y="111">0</text>
                    <text x="67" y="68">25</text>
                    <text x="120" y="51">50</text>
                    <text x="173" y="68">75</text>
                    <text x="197" y="111">100</text>
                  </g>

                  <g
                    data-remainder-gauge-needle
                    transform="rotate(<%= needle_angle %> 120 118)"
                  >
                    <rect
                      x="117.5"
                      y="32"
                      width="5"
                      height="88"
                    />
                  </g>

                  <g
                    data-remainder-gauge-hub
                    transform="rotate(<%= needle_angle %> 120 118)"
                  >
                    <circle cx="120" cy="118" r="12" />

                    <ellipse
                      data-remainder-gauge-hub-reflection
                      cx="116"
                      cy="113.5"
                      rx="3.5"
                      ry="2"
                      transform="rotate(-28 116 113.5)"
                    />
                  </g>

                  <text data-remainder-gauge-empty x="20" y="145">E</text>
                  <text data-remainder-gauge-full x="220" y="145">F</text>
                </svg>
              </div>
            </main>
          </article>
        <% end %>
      </main>
    </article>

    <% if @expenses.any? %>
      <article class="expense-list" data-testid="expense-list">
        <main>
          <article data-elevation="1">
            <header>
              <h2>Expenses</h2>
            </header>

            <main>
              <% @expenses_by_date.each do |date, expenses| %>
                <section data-expense-day data-testid="expense-day">
                  <header>
                    <h3>
                      <time datetime="<%= date.iso8601 %>"><%= date.to_fs(:long) %></time>
                    </h3>

                    <p>
                      <strong data-testid="expense-day-total">
                        <%= formatted_amount(@expense_totals_by_date.fetch(date), @budget.base_currency_code) %>
                        <%= @budget.base_currency_code %>
                      </strong>
                    </p>
                  </header>

                  <main>
                    <%= render expenses %>
                  </main>
                </section>
              <% end %>
            </main>
          </article>
        </main>
      </article>
    <% end %>

    <%= button_to "Reset budget", budget_path(@budget), method: :delete,
        data: { intent: "negative", turbo_confirm: "Delete this budget and all of its money, plans, and expenses permanently?" } %>

    <footer>
      <%= link_to new_budget_expense_path(@budget), role: "button", data: {
            appearance: "keycap",
            controller: "pressable",
            action: "keydown.shift+e@document->pressable#click"
          } do %>
        <%= icon_tag("plus") %>
        <span>Add expense</span>
        <kbd aria-hidden="true">E</kbd>
      <% end %>
    </footer>
  </article>
</main>
