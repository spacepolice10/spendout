<%= link_to expense_path(expense), data: { expense_link: true }, aria: { label: "View expense" } do %>
  <article class="expense" data-testid="expense-card">
    <main>
      <div data-expense-line>
        <% if expense.allocation %>
          <%= icon_tag(expense.allocation.icon, style: icon_colour_styles(expense.allocation.colour)) %>
        <% else %>
          <%= icon_tag(expense.source.icon, style: icon_colour_styles(expense.source.colour)) %>
        <% end %>

        <div data-expense-description>
          <strong data-expense-name>
            <% if expense.allocation %>
              <%= expense.allocation.name %>
              <%= "(Deleted)" if expense.allocation.deleted? %>
            <% else %>
              Unallocated
            <% end %>
          </strong>
        </div>

        <span data-expense-leader aria-hidden="true"></span>

        <span data-expense-amount>
          <strong><%= formatted_amount(expense.amount, expense.currency_code) %></strong>
          <small><%= expense.currency_code %></small>
        </span>
      </div>

      <%= tag.span("Note", data: { expense_note: true, testid: "expense-note" },
            aria: { label: "Has note" }, title: "Has note") if expense.note.present? %>
    </main>
  </article>
<% end %>
