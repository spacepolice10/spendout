<%= link_to expense_path(expense), data: { expense_link: true }, aria: { label: t(".view") } do %>
  <article class="expense" data-testid="expense-card">
    <main>
      <div data-expense-line>
        <%= icon(expense.category.icon, style: icon_colour_styles(expense.category.colour)) %>

        <% if expense.note.present? %>
          <span data-expense-note data-testid="expense-note" aria-label="<%= t(".with_note") %>" title="<%= t(".with_note") %>">
            <%= icon("note") %>
          </span>
        <% end %>

        <div data-expense-description>
          <strong data-expense-name>
            <%= expense.category.name %>
          </strong>
        </div>

        <span data-expense-leader aria-hidden="true"></span>

        <span data-expense-amount>
          <strong><%= formatted_amount(expense.amount, expense.currency_code) %></strong>
          <small><%= expense.currency_code %></small>
        </span>
      </div>

    </main>
  </article>
<% end %>
