<main data-size="sm" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <h1>New expense</h1>
      </nav>
    </header>

    <main>
      <% if @active_sources.any? %>
        <%= render "form",
              budget: @budget,
              expense: @expense,
              active_sources: @active_sources,
              active_allocations: @active_allocations,
              expense_currency_context: @expense_currency_context %>
      <% else %>
        <article data-elevation="1">
          <header>
            <h2>Add a source first</h2>
          </header>

          <main>
            <p>An expense needs an active source.</p>
          </main>
        </article>
        <%= link_to new_budget_source_path(@budget), role: "button", data: { appearance: "keycap" } do %>
          <%= icon_tag("plus") %>
          <span>New source</span>
        <% end %>
      <% end %>
    </main>
  </article>
</main>
