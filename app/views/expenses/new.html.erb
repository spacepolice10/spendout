<main data-size="sm" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <h1><%= t(".name") %></h1>
      </nav>
    </header>

    <main>
      <% if @active_sources.any? %>
        <%= render "form",
              budget: @budget,
              expense: @expense,
              active_sources: @active_sources,
              active_allocations: @active_allocations,
              expense_currency_context: @expense_currency_context %>
      <% else %>
        <article data-elevation="1">
          <header>
            <h2><%= t(".no_sources.name") %></h2>
          </header>

          <main>
            <p><%= t(".no_sources.description") %></p>
          </main>
        </article>
        <%= link_to new_budget_source_path(@budget), role: "button", data: { appearance: "keycap", intent: "primary" } do %>
          <%= icon("plus") %>
          <span><%= t(".no_sources.create_source") %></span>
        <% end %>
      <% end %>
    </main>
  </article>
</main>
