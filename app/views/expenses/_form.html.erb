<%= form_with model: [ budget, expense ], data: { expense_form: true } do |form| %>
  <% if expense.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(expense.errors.count, "error") %> prevented this expense
        from being saved:
      </h2>

      <ul>
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/amount_fields", form: form, amount_attribute: :amount, open: true %>

  <div data-expense-options>
    <div>
      <%= tag.details name: "form-details", data: {
            optional_item: true
          } do %>
        <summary>
          <span>From:</span>
          <small><%= expense.source&.name %></small>
        </summary>

        <div data-optional-item-control>
          <fieldset data-expense-sources>
            <div>
              <% active_sources.each do |source| %>
                <%= form.label :source_id, value: source.id,
                      style: "--source-colour: var(--color-palette-#{source.colour});" do %>
                  <%= form.radio_button :source_id, source.id, required: true, checked: true %>

                  <span>
                    <strong><%= source.name %></strong>

                    <small>
                      <%= formatted_amount(source.spendable_amount, source.currency_code) %>
                      available (<%= source.currency_code %>)
                    </small>
                  </span>
                <% end %>
              <% end %>
            </div>
          </fieldset>
        </div>
      <% end %>

      <%= tag.details name: "form-details", data: {
          optional_item: true,
          controller: "category-filter"
        }, open: expense.category_name_to_create.present? do %>
          <summary>
            <span> Category: </span>

            <small data-category-filter-target="summary">
              <%= expense.category_name_to_create.presence || expense.allocation&.name || "No allocation" %>
            </small>
          </summary>

          <div data-optional-item-control>
            <fieldset data-expense-allocations>
              <div
                data-create-category
                data-category-filter-target="filterForm"
              >
                <%= tag.input type: "text",
                    id: "expense_category_filter",
                    value: expense.category_name_to_create,
                    placeholder: "Find or add category",
                    autocomplete: "off",
                    aria: { label: "Find or add category" },
                    data: {
                      category_filter_target: "filter",
                      action: "input->category-filter#filter"
                    } %>

                <%= form.hidden_field :category_name_to_create,
                    data: {
                      category_filter_target: "pendingNameTextform"
                    } %>
              </div>

              <div data-category-filter-target="options">
                <%= tag.button icon_tag("plus"), type: "button",
              style: "margin-inline: 0;",
                hidden: active_allocations.any?,
                data: {
                  size: "lg",
                  category_filter_target: "createCategoryButton",
                  action: "category-filter#createPendingCategory"
                } %>

                <%= tag.button icon_tag("trash-simple"), type: "button",
                style: "margin-inline: 0;",
                hidden: true,
                data: {
                  size: "lg",
                  intent: "secondary",
                  category_filter_target: "cleanupCategoryButton",
                  action: "category-filter#cleanup"
                } %>

                <% active_allocations.each do |allocation| %>
                  <%= form.label :allocation_id, value: allocation.id,
                      style: "--allocation-colour: var(--color-palette-#{allocation.colour});",
                      data: {
                        category_filter_target: "option",
                        filter_value: allocation.name
                      } do %>
                    <%= form.radio_button :allocation_id, allocation.id,
                        data: {
                          category_filter_target: "allocation",
                          action: "change->category-filter#selectAllocation"
                        } %>

                    <%= icon_tag(allocation.icon) %>

                    <span><%= allocation.name %></span>
                  <% end %>
                <% end %>
              </div>

              <template data-category-filter-target="template">
                <div
                  data-category-filter-target="pendingCategory"
                  data-pending-category
                >
                  <label
                    style="--allocation-colour: var(--color-palette-<%= Colourable::DEFAULT_COLOUR %>);"
                  >
                    <input
                      type="radio"
                      name="expense[allocation_id]"
                      value=""
                      checked
                    >

                    <%= icon_tag(Iconable::DEFAULT_ICON) %>

                    <span data-category-filter-target="pendingCategoryName"></span>
                  </label>

                  <button
                    type="button"
                    aria-label="Delete new category"
                    data-action="category-filter#removePendingCategory"
                  >
                    Delete
                  </button>
                </div>
              </template>
            </fieldset>
          </div>
        <% end %>

      <%= tag.details name: "form-details", data: {
            optional_item: true
          }, open: expense.errors[:occurred_on].any? do %>
        <summary>
          <span> Date: </span>
          <small><%= expense.occurred_on&.to_fs(:long) %></small>
        </summary>

        <div data-optional-item-control>
          <%= form.label :occurred_on do %>
            <%= form.date_field :occurred_on,
                min: budget.period_from,
                max: budget.period_to,
                required: true %>
          <% end %>
        </div>
      <% end %>

      <%= tag.details name: "form-details", data: {
            optional_item: true
          }, open: expense.note.present? do %>
        <summary>
          <span> Note: </span>
          <%= tag.small("Added", hidden: expense.note.blank?) %>
        </summary>

        <div data-optional-item-control>
          <%= form.label :note do %>
            <%= form.text_field :note, maxlength: 200, size: nil, placeholder: "Optional" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div data-layout="flex">
    <%= link_to budget_path(budget), role: "button", data: { intent: "secondary", size: "lg" } do %>
      <%= icon_tag("chevron-left") %>
      <span>Cancel</span>
    <% end %>

    <%= form.button "Create", type: "submit", data: { intent: "primary", size: "lg" } %>
  </div>
<% end %>
