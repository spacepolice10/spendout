<%= form_with model: [ budget, expense ], data: {
      expense_form: true,
      controller: "form expense-fields",
      form_focused_on_toggle_value: !mobile_variant?,
      expense_fields_sources_value: expense_currency_context.to_json,
      expense_fields_reference_link_value: currency_reference_path
    } do |form| %>
  <% if expense.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(expense.errors.count, "error") %> prevented this expense
        from being saved:
      </h2>

      <ul>
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/amount_fields", form: form, amount_attribute: :amount, open: true,
        minimum_exclusive: true %>

  <div data-expense-options>
    <div>
      <%= tag.details name: "form-details", data: {
            optional_item: true,
            form_target: "section"
          } do %>
        <summary data-form-target="summary">
          <span>From:</span>
          <small><%= expense.source&.name %></small>
        </summary>

        <div data-optional-item-control>
          <fieldset data-expense-sources>
            <div>
              <% active_sources.each do |source| %>
                <%= form.label :source_id, value: source.id,
                      style: "--source-colour: var(--color-palette-#{source.colour});" do %>
                  <%= form.radio_button :source_id, source.id, required: true,
                        data: {
                          form_target: "toBeFocused",
                          expense_fields_target: "source",
                          action: "change->expense-fields#sourceChanged"
                        } %>

                  <span>
                    <strong><%= source.name %></strong>

                    <small>
                      <%= formatted_amount(source.spendable_amount, source.currency_code) %>
                      available (<%= source.currency_code %>)
                    </small>
                  </span>
                <% end %>
              <% end %>
            </div>

            <% unless mobile_variant? %>
              <small>
                Use <kbd>arrow keys</kbd> to switch.
              </small>
            <% end %>
          </fieldset>
        </div>
      <% end %>

      <%= tag.details name: "form-details", data: {
          optional_item: true,
          controller: "category-fields", form_target: "section"
        }, open: expense.category_name_to_create.present? do %>
        <summary data-form-target="summary">
          <span> Category: </span>

          <small data-category-fields-target="summary">
            <%= expense.category_name_to_create.presence || expense.allocation&.name || "No allocation" %>
          </small>
        </summary>

        <div data-optional-item-control>
          <fieldset data-expense-allocations>
            <div data-create-category>
              <%= tag.input type: "text",
                    id: "expense_category_filter",
                    value: expense.category_name_to_create,
                    placeholder: "Find or add category",
                    autocomplete: "off",
                    aria: { label: "Find or add category" },
                    data: {
                      category_fields_target: "filter",
                      form_target: "toBeFocused",
                      action: "input->category-fields#filter"
                    } %>

              <%= form.hidden_field :category_name_to_create,
                    data: {
                      category_fields_target: "pendingNameTextform"
                    } %>
            </div>

            <small data-category-fields-target="creationTip" hidden>
              Category named <strong data-category-fields-target="creationTipName"></strong> will be created
            </small>

            <div data-category-fields-target="options">
              <% active_allocations.each do |allocation| %>
                <%= form.label :allocation_id, value: allocation.id,
                      style: "--allocation-colour: var(--color-palette-#{allocation.colour});",
                      data: {
                        category_fields_target: "option",
                        filter_value: allocation.name
                      } do %>
                  <%= form.radio_button :allocation_id, allocation.id,
                        data: {
                          category_fields_target: "allocation",
                          action: "change->category-fields#selectAllocation"
                        } %>

                  <%= icon(allocation.icon) %>

                  <span><%= allocation.name %></span>
                <% end %>
              <% end %>
            </div>

            <% if active_allocations.any? && !mobile_variant? %>
              <small>
                Use <kbd>arrow keys</kbd> to switch.
              </small>
            <% end %>

          </fieldset>
        </div>
      <% end %>

      <%= tag.details name: "form-details", data: {
            optional_item: true,
            form_target: "section"
          }, open: expense.errors[:occurred_on].any? do %>
        <summary data-form-target="summary">
          <span> Date: </span>
          <small><%= expense.occurred_on&.to_fs(:long) %></small>
        </summary>

        <div data-optional-item-control>
          <%= form.label :occurred_on do %>
            <%= form.date_field :occurred_on,
                min: budget.period_from,
                max: budget.period_to,
                required: true,
                data: { form_target: "toBeFocused" } %>
          <% end %>
        </div>
      <% end %>

      <%= tag.details name: "form-details", data: {
            optional_item: true,
            form_target: "section"
          }, open: expense.note.present? do %>
        <summary data-form-target="summary">
          <span> Note: </span>
          <%= tag.small("Added", hidden: expense.note.blank?) %>
        </summary>

        <div data-optional-item-control>
          <%= form.label :note do %>
            <%= form.text_area :note, maxlength: 200, placeholder: "Optional",
                  data: { form_target: "toBeFocused" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shared/currency_fields", form: form,
        currency_attribute: :currency_code, rate_attribute: :conversion_rate,
        base_currency_code: expense.source&.currency_code,
        open: expense.errors[:currency_code].any? || expense.errors[:conversion_rate].any?,
        preferred_currencies: [ budget.last_expense_currency_code,
          budget.base_currency_code, expense.source&.currency_code ] %>

  <footer>
    <div data-layout="flex">
      <%= link_to budget_expenses_path(budget), role: "button", data: {
          appearance: "keycap", intent: "secondary", size: "lg",
          controller: "pressable", action: "keydown.shift+esc@document->pressable#click"
        } do %>
        <%= icon("chevron-left") %>
        <span>Cancel</span>
        <% unless mobile_variant? %>
          <kbd aria-hidden="true">Shift + Escape</kbd>
        <% end %>
      <% end %>

      <%= form.button type: "submit", data: {
          appearance: "keycap", intent: "primary", size: "lg",
          controller: "pressable", action: "keydown.meta+enter@document->pressable#click"
        } do %>
        <span>Confirm</span>
        <%= icon("chevron-right") %>
        <% unless mobile_variant? %>
          <kbd aria-hidden="true">Cmd + Enter</kbd>
        <% end %>
      <% end %>
    </div>
  </footer>
<% end %>
