<%= form_with model: [ budget, expense ], data: { expense_form: true } do |form| %>
  <% if expense.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(expense.errors.count, "error") %> prevented this expense
        from being saved:
      </h2>

      <ul>
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form.label :amount do %>
    <legend>How much?</legend>

    <%= form.text_field :amount, inputmode: "decimal", placeholder: "0", required: true, autofocus: true,
        aria: { label: "Amount" },
        data: {
          controller: "money-input",
          money_input_start_value: expense.amount&.to_s("F")
        } %>
  <% end %>

  <div data-expense-options>
    <div>
      <%= tag.details data: {
            optional_item: true
          }, class: ("utilities--sr-only" if active_sources.one?) do %>
        <summary>
          <span>
            <%= icon_tag("plus") %>
            From
          </span>
          <small><%= expense.source&.name %></small>
        </summary>

        <div data-optional-item-control>
          <fieldset data-expense-sources>
            <div>
              <% active_sources.each do |source| %>
                <%= form.label :source_id, value: source.id,
                      style: "--source-colour: var(--color-palette-#{source.colour});" do %>
                  <%= form.radio_button :source_id, source.id, required: true %>

                  <%= icon_tag(source.icon) %>

                  <span>
                    <strong><%= source.name %></strong>

                    <small>
                      <%= formatted_amount(source.spendable_amount, source.currency) %>
                      available (<%= source.currency_code %>)
                    </small>
                  </span>
                <% end %>
              <% end %>
            </div>
          </fieldset>
        </div>
      <% end %>

      <%= tag.details data: {
            optional_item: true
          }, open: expense.category_name_to_create.present? do %>
        <summary>
          <span>
            <%= icon_tag("plus") %>
            Spend on
          </span>

          <small>
            <%= expense.category_name_to_create.presence || expense.allocation&.name || "No allocation" %>
          </small>
        </summary>

        <div data-optional-item-control>
          <fieldset data-expense-allocations data-controller="category-filter">
            <div data-create-category>
              <%= tag.input type: "text",
                    id: "expense_category_filter",
                    value: expense.category_name_to_create,
                    placeholder: "Find or add category",
                    autocomplete: "off",
                    aria: { label: "Find or add category" },
                    data: {
                      category_filter_target: "filter",
                      action: "input->category-filter#filter"
                    } %>

              <%= form.hidden_field :category_name_to_create,
                    data: {
                      category_filter_target: "createdTextform"
                    } %>

              <div>
                <%= tag.button "Add new", type: "button",
                    hidden: true,
                    data: {
                      size: "lg",
                      category_filter_target: "createdButton",
                      action: "category-filter#selectCreatedCategory"
                    } %>

                <%= tag.button "Cleanup", type: "button",
                    hidden: true,
                    data: {
                      size: "lg",
                      intent: "secondary",
                      category_filter_target: "cleanupButton",
                      action: "category-filter#cleanup"
                    } %>
              </div>
            </div>

            <div>
              <% active_allocations.each do |allocation| %>
                <%= form.label :allocation_id, value: allocation.id,
                      style: "--allocation-colour: var(--color-palette-#{allocation.colour});",
                      data: {
                        category_filter_target: "option",
                        filter_value: allocation.name
                      } do %>
                  <%= form.radio_button :allocation_id, allocation.id,
                        data: {
                          category_filter_target: "allocation",
                          action: "change->category-filter#selectAllocation"
                        } %>

                  <%= icon_tag(allocation.icon) %>

                  <span><%= allocation.name %></span>
                <% end %>
              <% end %>
            </div>
          </fieldset>
        </div>
      <% end %>

      <%= tag.details data: {
            optional_item: true
          }, open: expense.errors[:occurred_on].any? do %>
        <summary>
          <span>
            <%= icon_tag("plus") %>
            Date
          </span>
          <small><%= expense.occurred_on&.to_fs(:long) %></small>
        </summary>

        <div data-optional-item-control>
          <%= form.label :occurred_on do %>
            <%= form.date_field :occurred_on,
                min: budget.period_from,
                max: budget.period_to,
                required: true %>
          <% end %>
        </div>
      <% end %>

      <%= tag.details data: {
            optional_item: true
          }, open: expense.note.present? do %>
        <summary>
          <span>
            <%= icon_tag("plus") %>
            Note
          </span>
          <%= tag.small("Added", hidden: expense.note.blank?) %>
        </summary>

        <div data-optional-item-control>
          <%= form.label :note do %>

            <%= form.text_field :note, maxlength: 200, size: nil, placeholder: "Optional" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= form.submit "Create", data: { intent: "primary" } %>
<% end %>
