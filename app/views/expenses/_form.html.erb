<%= form_with model: [ budget, expense ], data: {
      expense_form: true,
      controller: "form expense-fields",
      expense_fields_sources_value: expense_currency_context.to_json,
      expense_fields_reference_link_value: currency_reference_path
    } do |form| %>
  <%= form.hidden_field :recurrence_id %>
  <% if expense.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= t(".errors", count: expense.errors.count) %>
      </h2>

      <ul>
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/amount_with_currency_fields", form: form %>

  <div data-expense-options>
    <div>
      <div data-source-picker data-controller="source-picker">
        <button type="button" aria-haspopup="dialog" aria-controls="source-picker-dialog"
          data-expense-picker-trigger data-source-picker-target="trigger" data-action="source-picker#open">
          <span><%= t(".source.name") %></span>
          <small data-source-picker-target="summary"><%= expense.source&.name %></small>
        </button>

        <dialog id="source-picker-dialog" aria-label="<%= t(".source.choose") %>" tabindex="-1" closedby="any"
          data-source-picker-target="dialog" data-action="close->source-picker#closed keydown->source-picker#keydown">
          <header>
            <h2><%= t(".source.choose") %></h2>
            <button type="button" aria-label="<%= t(".source.close") %>" data-action="source-picker#close">&times;</button>
          </header>

          <div role="listbox" data-source-picker-target="options">
            <% active_sources.each do |source| %>
              <div data-source-picker-option>
                <%= form.label :source_id, value: source.id, id: "expense-source-option-#{source.id}",
                      role: "option", tabindex: -1, aria: { selected: source == expense.source },
                      style: "--source-colour: var(--color-palette-#{source.colour});",
                      data: { source_picker_target: "option", selection_value: source.name,
                        action: "click->source-picker#select" } do %>
                  <%= form.radio_button :source_id, source.id, required: true,
                        data: { expense_fields_target: "source", action: "change->expense-fields#sourceChanged" } %>

                  <%= render "sources/design", design: Source::DESIGNS.fetch(source.design), colour: source.colour %>
                  <span>
                    <strong><%= source.name %></strong>
                    <small><%= t(".source.availability", amount: formatted_amount(source.spendable_amount, source.currency_code), currency: source.currency_code) %></small>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        </dialog>
      </div>

      <div data-category-picker data-controller="category-fields"
        data-category-fields-no-allocation-value="<%= t(".category.no_allocation") %>">
        <%= form.hidden_field :category_name_to_create, data: { category_fields_target: "pendingNameTextform" } %>

        <button type="button" aria-haspopup="dialog" aria-controls="category-picker-dialog"
          data-expense-picker-trigger data-category-fields-target="trigger" data-action="category-fields#open">
          <span><%= t(".category.name") %></span>
          <small data-category-fields-target="summary"><%= expense.category_name_to_create.presence || expense.category&.name || t(".category.choose") %></small>
        </button>

        <dialog id="category-picker-dialog" aria-label="<%= t(".category.choose") %>" closedby="any"
          data-category-fields-target="dialog" data-action="close->category-fields#closed">
          <header>
            <h2><%= t(".category.choose") %></h2>
            <button type="button" aria-label="<%= t(".category.close") %>" data-action="category-fields#close">&times;</button>
          </header>

          <div data-category-combobox>
            <%= icon("search", data: { category_search_icon: true }) %>
            <input type="search" id="expense_category_filter" value="<%= expense.category_name_to_create %>"
              placeholder="<%= t(".category.search") %>" autocomplete="off" role="combobox"
              aria-label="<%= t(".category.search") %>" aria-autocomplete="list" aria-expanded="true"
              aria-controls="category-picker-listbox" data-category-fields-target="filter"
              data-action="input->category-fields#filter keydown->category-fields#keydown">
          </div>

          <label data-category-fields-target="creationTip" hidden>
            <%= form.radio_button :category_id, "", required: true,
                  data: { category_fields_target: "allocation creation" } %>
            <small><%= t(".category.creation_html", name: tag.strong("", data: { category_fields_target: "creationTipName" })) %></small>
          </label>

          <div id="category-picker-listbox" role="listbox" data-category-fields-target="options">
            <% active_categories.each do |category| %>
              <div data-category-picker-option>
                <%= form.label :category_id, value: category.id, id: "expense-category-option-#{category.id}",
                      role: "option", aria: { selected: category == expense.category },
                      style: "--allocation-colour: var(--color-palette-#{category.colour});",
                      data: { category_fields_target: "option", filter_value: category.name,
                        selection_value: category.name, action: "click->category-fields#selectAllocation" } do %>
                  <%= form.radio_button :category_id, category.id, required: true,
                        data: { category_fields_target: "allocation" } %>
                  <%= icon(category.icon, style: icon_colour_styles(category.colour)) %>
                  <span>
                    <strong><%= category.name %></strong>
                    <% if category.allocation&.active? %>
                      <small><%= t(".category.remaining", amount: formatted_amount(category.allocation.remaining_amount, category.allocation.currency_code), currency: category.allocation.currency_code) %></small>
                    <% else %>
                      <small><%= t(".category.unplanned") %></small>
                    <% end %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>

          <footer>
            <button type="button" data-intent="primary" data-category-fields-target="confirm"
              data-action="category-fields#confirm" disabled><%= t(".category.confirm") %></button>
          </footer>
        </dialog>
      </div>

      <%= form.label :occurred_on, data: { expense_date: true } do %>
        <span><%= t(".date") %></span>
        <%= form.date_field :occurred_on,
            min: budget.period_from,
            max: budget.period_to,
            required: true %>
      <% end %>

      <%= form.label :note, data: { expense_note: true } do %>
        <span><%= t(".note") %></span>
        <%= form.text_field :note, maxlength: 200, placeholder: t(".note_placeholder") %>
      <% end %>
    </div>
  </div>

  <%= render "shared/form_actions", form:, cancel_path: budget_lenses_path(budget),
        cancel_label: t(".cancel"), submit_label: t(".submit") %>
<% end %>
