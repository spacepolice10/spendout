<%= form_with model: [ budget, expense ], data: { expense_form: true } do |form| %>
  <% if expense.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(expense.errors.count, "error") %> prevented this expense
        from being saved:
      </h2>

      <ul>
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form.label :source_id do %>
    <legend>From</legend>

    <%= form.select :source_id,
          active_sources.map { |source| [ "#{source.name} — #{formatted_amount(source.spendable_amount, source.currency)} available (#{source.currency_code})", source.id ] },
          {},
          required: true %>
  <% end %>

  <%= form.label :amount do %>
    <legend>How much?</legend>

    <%= form.text_field :amount, inputmode: "decimal", placeholder: "0", required: true, autofocus: true,
        aria: { label: "Amount" },
        data: {
          controller: "money-input",
          money_input_start_value: expense.amount&.to_s("F")
        } %>
  <% end %>

  <fieldset data-expense-allocations>
    <legend>Spend on</legend>

    <div>
      <%= form.label :allocation_id, value: "", for: "expense_allocation_id_none" do %>
        <%= form.radio_button :allocation_id, "", id: "expense_allocation_id_none" %>
        No allocation
      <% end %>

      <% active_allocations.each do |allocation| %>
        <%= form.label :allocation_id, value: allocation.id,
              style: "--allocation-colour: var(--color-palette-#{allocation.colour});" do %>
          <%= form.radio_button :allocation_id, allocation.id %>
          <%= icon_tag(allocation.icon) %>

          <span><%= allocation.name %></span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <fieldset data-expense-options>
    <div>
      <div data-optional-item>
        <%= tag.input type: "checkbox", id: "expense-date-item-toggle",
              checked: expense.errors[:occurred_on].any?, data: { optional_item_toggle: true }, aria: { label: "Show date field" } %>

        <%= tag.label "+ Date", for: "expense-date-item-toggle" %>

        <div data-optional-item-control>
          <%= form.label :occurred_on do %>
            <legend>Date</legend>

            <%= form.date_field :occurred_on,
                min: budget.period_from,
                max: budget.period_to,
                required: true %>
          <% end %>
        </div>
      </div>

      <div data-optional-item>
        <%= tag.input type: "checkbox", id: "expense-note-toggle",
              checked: expense.note.present?, data: { optional_item_toggle: true }, aria: { label: "Show note field" } %>

        <%= tag.label "+ Note", for: "expense-note-toggle" %>

        <div data-optional-item-control>
          <%= form.label :note do %>
            <legend>Note</legend>
            <%= form.text_field :note, maxlength: 200, size: nil, placeholder: "Optional" %>
          <% end %>
        </div>
      </div>

      <div data-optional-item>
        <%= tag.input type: "checkbox", id: "expense-category-toggle",
              checked: expense.category_name_to_create.present?, data: { optional_item_toggle: true }, aria: { label: "Show category field" } %>

        <%= tag.label "+ Category", for: "expense-category-toggle" %>

        <div data-optional-item-control>
          <%= form.label :category_name_to_create do %>
            <legend>New category</legend>
            <%= form.text_field :category_name_to_create, size: nil, placeholder: "Category name" %>
          <% end %>
        </div>
      </div>
    </div>
  </fieldset>

  <%= form.submit "Create", data: { intent: "primary" } %>
<% end %>
