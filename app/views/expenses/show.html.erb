<main data-size="sm" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <%= link_to icon_tag("chevron-left"), budget_expenses_path(@budget), aria: { label: "Back to expenses" } %>
        <h1>Expense</h1>
      </nav>
      <time datetime="<%= @expense.occurred_on.iso8601 %>"><%= @expense.occurred_on.to_fs(:long) %></time>
    </header>

    <main>
      <dl>
        <dt>Amount</dt>
        <dd><%= formatted_amount(@expense.amount, @expense.currency_code) %> <%= @expense.currency_code %></dd>
        <dt>Source</dt>
        <dd>
          <%= link_to @expense.source.name, source_path(@expense.source) %>
          <%= "(Deleted)" if @expense.source.deleted? %>
        </dd>
        <dt>Source debit</dt>
        <dd><%= formatted_amount(@expense.source_amount, @expense.source_currency_code) %> <%= @expense.source_currency_code %></dd>
        <% if @expense.currency_code != @expense.source_currency_code %>
          <dt>Conversion quote</dt>
          <dd><%= @expense.conversion_rate.to_s("F") %> <%= @expense.currency_code %> per 1 <%= @expense.source_currency_code %></dd>
        <% end %>
        <dt>Budget value</dt>
        <dd><%= formatted_amount(@expense.amount_in_base, @budget.base_currency_code) %> <%= @budget.base_currency_code %></dd>
        <dt>Allocation</dt>
        <dd>
          <% if @expense.allocation %>
            <%= icon_tag(@expense.allocation.icon, style: icon_colour_styles(@expense.allocation.colour)) %>
            <%= link_to @expense.allocation.name, allocation_path(@expense.allocation) %>
            <%= "(Deleted)" if @expense.allocation.deleted? %>
          <% else %>
            No allocation
          <% end %>
        </dd>
        <% if @expense.note.present? %>
          <dt>Note</dt>
          <dd><%= @expense.note %></dd>
        <% end %>
      </dl>
    </main>

    <footer>
      <%= button_to "Delete expense", expense_path(@expense), method: :delete,
            data: { intent: "negative", turbo_confirm: "Delete this expense permanently?" } %>
    </footer>
  </article>
</main>
