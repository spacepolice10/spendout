<main data-size="sm" data-anchor="footer">
  <article data-elevation="1" data-expense-receipt>
    <header>
      <nav>
        <h1>Expense</h1>
      </nav>
      <small>Receipt</small>
    </header>

    <main>
      <section data-expense-hero>
        <div data-expense-category>
          <% if @expense.allocation %>
            <%= icon(@expense.allocation.icon, style: icon_colour_styles(@expense.allocation.colour)) %>
            <p>
              <small>Category</small>
              <strong>
                <%= link_to @expense.allocation.name, allocation_path(@expense.allocation) %>
                <%= @expense.allocation.deleted? ? "(Deleted)" : ("(Finished)" if @expense.allocation.finished?) %>
              </strong>
            </p>
          <% else %>
            <%= icon("circle-dot") %>
            <p><small>Category</small><strong>Unallocated</strong></p>
          <% end %>
        </div>

        <p data-expense-total>
          <strong><%= formatted_amount(@expense.amount, @expense.currency_code) %></strong>
          <small><%= @expense.currency_code %></small>
        </p>

        <time datetime="<%= @expense.occurred_on.iso8601 %>"><%= @expense.occurred_on.to_fs(:long) %></time>
      </section>

      <section data-expense-source style="<%= colour_styles(@expense.source.colour) %>">
        <%= icon(@expense.source.icon) %>
        <p>
          <small>Paid from</small>
          <strong>
            <%= link_to @expense.source.name, source_path(@expense.source) %>
            <%= "(Deleted)" if @expense.source.deleted? %>
          </strong>
        </p>
        <p data-expense-source-debit>
          <strong><%= formatted_amount(@expense.source_amount, @expense.source.currency_code) %></strong>
          <small><%= @expense.source.currency_code %></small>
        </p>
      </section>

      <dl data-expense-breakdown>
        <% if @expense.currency_code != @expense.source.currency_code %>
          <div>
            <dt>Conversion quote</dt>
            <span aria-hidden="true"></span>
            <dd><%= @expense.conversion_rate.to_s("F") %> <%= @expense.currency_code %> / <%= @expense.source.currency_code %></dd>
          </div>
        <% end %>
        <div>
          <dt>Budget value</dt>
          <span aria-hidden="true"></span>
          <dd><%= formatted_amount(@expense.amount_in_base_currency, @budget.base_currency_code) %> <%= @budget.base_currency_code %></dd>
        </div>
      </dl>

      <% if @expense.note.present? %>
        <aside data-expense-receipt-note>
          <%= icon("note") %>
          <p><small>Note</small><strong><%= @expense.note %></strong></p>
        </aside>
      <% end %>
    </main>

    <footer>
      <%= button_to "Delete expense", expense_path(@expense), method: :delete,
            data: { intent: "negative", appearance: "keycap", turbo_confirm: "Delete this expense permanently?" } %>
    </footer>
  </article>
</main>
