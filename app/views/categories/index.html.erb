<% content_for :title, t(".name") %>
<main data-size="lg" data-anchor="footer"><article data-elevation="1"><header><nav><h1><%= t(".name") %></h1></nav></header><main>
  <% if @categories.any? %><section data-layout="grid"><% @categories.each do |category| %><article data-elevation="1"><header><%= icon(category.icon, style: icon_colour_styles(category.colour)) %><h2><%= link_to category.name, budget_category_path(@budget, category) %></h2></header><main><p><%= t(".spent", amount: formatted_amount(category.used_amount, @budget.base_currency_code), currency: @budget.base_currency_code) %></p><% if category.allocation %><p><%= t(".planned", amount: formatted_amount(category.allocation.amount, category.allocation.currency_code), currency: category.allocation.currency_code) %></p><% end %></main></article><% end %></section><% else %><p><%= t(".empty") %></p><% end %>
</main></article></main>
<% content_for :budget_action_footer do %><footer class="floating-actions" data-budget-action><%= link_to new_budget_allocation_path(@budget), role: "button", data: { intent: "primary" } do %><%= icon("plus") %><span><%= t("allocations.index.create_allocation") %></span><% end %></footer><% end %>
