<main data-size="sm"><article data-elevation="1"><header><%= icon(@category.icon, style: icon_colour_styles(@category.colour)) %><h1><%= @category.name %></h1></header><main><%= render "form", budget: @budget, category: @category %></main><footer><%= button_to t(".remove"), budget_category_path(@budget, @category), method: :delete, data: { intent: "negative", turbo_confirm: t(".remove_confirmation") } %></footer></article></main>
