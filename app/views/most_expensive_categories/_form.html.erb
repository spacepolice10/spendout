<%= form_with model: most_expensive_categories, url: budget_most_expensive_categories_path(budget), data: { controller: "form" } do |form| %><% if most_expensive_categories.errors.any? %><section role="alert" data-form-errors><ul><% most_expensive_categories.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></section><% end %><%= form.label :starts_on do %><span><%= t(".starts_on") %></span><%= form.date_field :starts_on, min: budget.period_from, max: budget.period_to, required: true %><% end %><%= render "shared/form_actions", form:, cancel_path: budget_lenses_path(budget), cancel_label: t(".cancel"), submit_label: t(".submit") %><% end %>
