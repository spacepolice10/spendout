<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <h1>Exchange from <%= @parent_source.name %></h1>
      </nav>
      <small>
        Available:
        <%= formatted_amount(@parent_source.spendable_amount, @parent_source.currency_code) %>
        <%= @parent_source.currency_code %>
      </small>
    </header>

    <main>
      <%= render "form", budget: @budget, parent_source: @parent_source, exchange: @exchange %>
    </main>
  </article>
</main>
