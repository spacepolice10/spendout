<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <h1>Exchange from <%= @sender_source.name %></h1>
      </nav>
      <small>
        Available:
        <%= formatted_amount(@sender_source.spendable_amount, @sender_source.currency_code) %>
        <%= @sender_source.currency_code %>
      </small>
    </header>

    <main>
      <%= render "form", budget: @budget, sender_source: @sender_source, exchange: @exchange %>
    </main>
  </article>
</main>
