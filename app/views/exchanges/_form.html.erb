<% source_context = sources.to_h { |source| [ source.id, { currency: source.currency_code } ] } %>

<%= form_with model: [ budget, exchange ], data: { exchange_form: true, controller: "form exchange-fields", exchange_fields_sources_value: source_context.to_json } do |form| %>
  <% if exchange.errors.any? %>
    <section role="alert" data-form-errors>
      <ul><% exchange.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </section>
  <% end %>

  <%= render "shared/amount_with_currency_fields", form: %>

  <div data-exchange-options>
    <div>
      <%= render "shared/source_picker", form:, attribute: :sender_source_id, sources:, selected_source: exchange.sender_source,
            label: t(".from"), picker_id: "exchange-source-picker",
            input_data: { exchange_fields_target: "source", action: "change->exchange-fields#sourceChanged" } %>

      <%= form.label :receiver_source_name, data: { expense_note: true } do %>
        <span><%= t(".name") %></span>
        <%= form.text_field :receiver_source_name, required: true, placeholder: t(".name_placeholder"),
          autofocus: !mobile_variant? %>
      <% end %>
    </div>
  </div>

  <%= render "shared/form_actions", form:, cancel_path: budget_lenses_path(budget),
        cancel_label: t(".cancel"), submit_label: t(".submit") %>
<% end %>
