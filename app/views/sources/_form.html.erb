<%= form_with model: [ budget, source ], data: {
      source_form: true,
      controller: "currency-conversion",
      currency_conversion_base_currency_value: budget.base_currency_code
    } do |form| %>
  <% if source.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(source.errors.count, "error") %> prevented this source
        from being saved:
      </h2>

      <ul>
        <% source.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/name_fields", form: form, name_attribute: :name, placeholder: "Credit card, cash, loan, etc." %>
  <%= render "shared/amount_fields", form: form, amount_attribute: :amount, default_amount: true %>

  <%= render "shared/currency_fields", form: form,
        currency_attribute: :currency_code, rate_attribute: :rate,
        base_currency_code: budget.base_currency_code %>

  <%= render "shared/appearance_fields", form: form %>

  <div data-layout="flex">
    <%= link_to budget_sources_path(budget), role: "button", data: { intent: "secondary", size: "lg" } do %>
      <%= icon_tag("chevron-left") %>
      <span>Cancel</span>
    <% end %>
    <%= form.button "Save", type: "submit", data: { intent: "primary", size: "lg" } %>
  </div>
<% end %>
