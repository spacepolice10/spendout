<%= form_with model: [ budget, source ], data: {
      controller: "form"
    } do |form| %>
  <% if source.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= t(".errors", count: source.errors.count) %>
      </h2>

      <ul>
        <% source.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/amount_with_currency_fields", form: form %>
  <%= render "shared/name_fields", form: form, placeholder: t(".name_placeholder") %>

  <%= render "shared/colour_fields", form: form %>
  <%= render "design_fields", form: form, source: source %>

  <%= render "shared/form_actions", form:, cancel_path: budget_lenses_path(budget),
        cancel_label: t(".cancel"), submit_label: t(".submit") %>
<% end %>
