<%= form_with model: [ budget, source ], data: { source_form: true } do |form| %>
  <% if source.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(source.errors.count, "error") %> prevented this source
        from being saved:
      </h2>

      <ul>
        <% source.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form.label :name %>
  <%= form.text_field :name, required: true, autofocus: true %>

  <%= form.label :amount %>
  <%= form.number_field :amount, min: 0, step: 0.0001, required: true %>

  <%= form.label :currency_code, "Currency" %>
  <%= form.select :currency_code,
        budget.currencies.map { |currency| [ "#{currency.name} (#{currency.alphabetic_code})", currency.alphabetic_code ] },
        {}, required: true %>

  <fieldset data-layout="flex">
    <legend>Icon</legend>

    <div>
      <%= form.collection_radio_buttons :icon, Source.icon_options, :second, :first do |radio| %>
        <%= radio.label title: radio.text do %>
          <%= radio.radio_button aria: { label: radio.text } %>
          <%= icon_tag(radio.value) %>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <fieldset data-layout="flex">
    <legend>Colour</legend>

    <div>
      <%= form.collection_radio_buttons :colour, Source.colour_options, :second, :first do |radio| %>
        <%= radio.label style: "--background-color-checked: var(--color-palette-#{radio.value}); --color-checked: var(--color-invert-1);" do %>
          <%= radio.radio_button %>
          <%= radio.text %>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <%= form.submit %>
<% end %>
