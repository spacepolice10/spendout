<% reference_rates = CurrencyReferenceRates.for(budget.base_currency_code) %>
<%= form_with model: [ budget, source ], data: {
      source_form: true,
      controller: "currency-conversion",
      currency_conversion_base_currency_value: budget.base_currency_code,
      currency_conversion_rates_value: reference_rates.rates.to_json,
      currency_conversion_reference_date_value: reference_rates.reference_date&.iso8601,
      currency_conversion_provider_value: reference_rates.provider
    } do |form| %>
  <% if source.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(source.errors.count, "error") %> prevented this source
        from being saved:
      </h2>

      <ul>
        <% source.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/name_fields", form: form, placeholder: "Credit card, cash, loan, etc." %>
  <%= render "shared/amount_fields", form: form, amount_attribute: :amount, default_amount: true %>

  <%= render "shared/currency_fields", form: form,
        currency_attribute: :currency_code, rate_attribute: :rate,
        base_currency_code: budget.base_currency_code %>

  <%= render "shared/icon_fields", form: form %>
  <%= render "shared/colour_fields", form: form %>

  <div data-layout="flex">
    <%= link_to budget_sources_path(budget), role: "button", data: {
          appearance: "keycap", intent: "secondary", size: "lg",
          controller: "pressable", action: "keydown.shift+esc@document->pressable#click"
        } do %>
      <%= icon_tag("chevron-left") %>
      <span>Cancel</span>
      <% unless mobile_variant? %>
        <kbd aria-hidden="true">Shift + Escape</kbd>
      <% end %>
    <% end %>
    <%= form.button type: "submit", data: {
          appearance: "keycap", intent: "primary", size: "lg",
          controller: "pressable", action: "keydown.meta+enter@document->pressable#click"
        } do %>
      <span>Confirm</span>
      <%= icon_tag("chevron-right") %>
      <% unless mobile_variant? %>
        <kbd aria-hidden="true">Cmd + Enter</kbd>
      <% end %>
    <% end %>
  </div>
<% end %>
