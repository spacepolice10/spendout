<%# locals: (design:, colour:, alt: "", variant: "thumbnail", loading: "eager") %>
<span
  data-source-design="<%= variant %>"
  role="<%= alt.present? ? "img" : "presentation" %>"
  aria-label="<%= alt %>"
  style="--source-colour: var(--color-palette-<%= colour %>);"
>
  <span data-source-design-accent aria-hidden="true"></span>
  <% if design.fetch(:face) %>
    <%= image_tag design.fetch(:face), alt: "", width: 1254, height: 1254,
          loading: loading, data: { source_design_face: true } %>
  <% end %>
</span>
