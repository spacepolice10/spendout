<%# locals: (design:, colour:, alt: "", variant: "thumbnail") %>
<span
  data-source-design="<%= variant %>"
  data-source-pattern="<%= design.fetch(:pattern) %>"
  role="<%= alt.present? ? "img" : "presentation" %>"
  aria-label="<%= alt %>"
  style="--source-colour: var(--color-palette-<%= colour %>);"
></span>
