<main data-size="sm">
  <article data-elevation="1" style="<%= colour_styles(@source.colour) %>">
    <header>
      <nav>
        <%= link_to icon_tag("chevron-left"), budget_sources_path(@budget), aria: { label: "Back to sources" } %>
        <%= icon_tag(@source.icon) %>
        <h1><%= @source.name %></h1>
      </nav>
      <small><%= "Deleted" if @source.deleted? %></small>
    </header>

    <%= tag.p(flash[:notice]) if flash[:notice] %>

    <main>
      <dl>
        <dt>Amount</dt>
        <dd><%= formatted_amount(@source.amount, @source.currency) %> <%= @source.currency.alphabetic_code %></dd>
        <dt>Budget</dt>
        <dd><%= link_to @budget.name, budget_path(@budget) %></dd>
      </dl>
    </main>
  </article>
</main>
