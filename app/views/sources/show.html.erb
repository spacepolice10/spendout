<% content_for :title, @source.name %>

<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <%= link_to icon("chevron-left"), budget_sources_path(@budget), aria: { label: "Back to sources" } %>
        <%= icon(@source.icon, style: icon_colour_styles(@source.colour)) %>
        <h1><%= @source.name %></h1>
      </nav>
      <small><%= "Deleted" if @source.deleted? %></small>
    </header>

    <main>
      <section data-layout="grid" aria-label="Source summary">
        <article data-elevation="2" data-testid="source-initial-amount">
          <header>
            <nav>
              <%= icon("cash-banknote") %>
              <h2>Initial amount</h2>
            </nav>
          </header>
          <main>
            <p><strong><%= formatted_amount(@source.amount, @source.currency_code) %> <%= @source.currency_code %></strong></p>
            <small>Added when this source was created</small>
          </main>
        </article>

        <article data-elevation="2" data-testid="source-available-amount">
          <header>
            <nav>
              <%= icon("wallet") %>
              <h2>Available now</h2>
            </nav>
          </header>
          <main>
            <p><strong><%= formatted_amount(@source.spendable_amount, @source.currency_code) %> <%= @source.currency_code %></strong></p>
            <small>After expenses and exchanges</small>
          </main>
        </article>

        <article data-elevation="2" data-testid="source-budget">
          <header>
            <nav>
              <%= icon("history") %>
              <h2>Budget</h2>
            </nav>
          </header>
          <main>
            <p><strong><%= link_to @budget.date_period, budget_expenses_path(@budget) %></strong></p>
            <small>Budget period for this source</small>
          </main>
        </article>
      </section>

      <% if @expenses.any? %>
        <article
          data-elevation="1"
          class="expense-list"
          data-testid="expense-list"
        >
          <header>
            <h2>Expenses</h2>
          </header>

          <main>
            <% @expenses_by_date.each do |date, expenses| %>
              <section data-expense-day data-testid="expense-day">
                <header>
                  <h3>
                    <time datetime="<%= date.iso8601 %>"><%= date.to_fs(:long) %></time>
                  </h3>

                  <p>
                    <strong data-testid="expense-day-total">
                      <%= formatted_amount(@expense_totals_by_date.fetch(date), @source.currency_code) %>
                      <%= @source.currency_code %>
                    </strong>
                  </p>
                </header>

                <main>
                  <%= render expenses %>
                </main>
              </section>
            <% end %>
          </main>

          <%= render "shared/pagination", page: @page, records_name: "source expenses" %>
        </article>
      <% end %>
    </main>

    <% unless @source.deleted? %>
      <footer>
        <%= link_to new_source_exchange_path(@source), role: "button", data: { intent: "secondary" } do %>
          <%= icon("coin") %>
          <span>Make exchange</span>
        <% end %>

        <%= button_to source_path(@source), method: :delete, aria: { label: "Remove source" }, data: { intent: "secondary", turbo_confirm: "Are you sure you want to remove this source?" } do %>
          <%= icon("trash-simple") %>
        <% end %>
      </footer>
    <% end %>
  </article>
</main>
