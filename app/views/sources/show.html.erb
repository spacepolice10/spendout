<% content_for :title, @source.name %>

<main data-size="lg" data-anchor="footer">
  <article style="--source-colour: var(--color-palette-<%= @source.colour %>);">
    <main>
      <%= image_tag @source.design_image, alt: t(".design_description", design: @source.design_name),
            width: 720, height: 464, data: { source_design_hero: true } %>

      <hgroup data-source-title>
        <h1><%= @source.name %></h1>
        <small><%= t(".deleted") if @source.deleted? %></small>
      </hgroup>

      <section aria-label="<%= t(".summary_name") %>" data-source-summary>
        <p>
          <span>
            <%= t(".initial_amount") %>
            <strong><%= formatted_amount(@source.amount, @source.currency_code) %> <%= @source.currency_code %></strong>
          </span>
          <span aria-hidden="true">·</span>
          <span>
            <%= t(".remainder") %>
            <strong><%= formatted_amount(@source.spendable_amount, @source.currency_code) %> <%= @source.currency_code %></strong>
          </span>
        </p>
      </section>

      <div data-source-actions>
        <%= link_to budget_sources_path(@budget), role: "button", aria: { label: t(".back") }, data: { intent: "secondary" } do %>
          <%= icon("chevron-left") %>
          <span><%= t(".back_name") %></span>
        <% end %>

        <% unless @source.deleted? %>
          <%= link_to new_source_exchange_path(@source), role: "button", data: { intent: "secondary" } do %>
            <%= icon("coin") %>
            <span><%= t(".exchange") %></span>
          <% end %>

          <%= button_to source_path(@source), method: :delete, aria: { label: t(".remove") }, data: { intent: "secondary", turbo_confirm: t(".remove_confirmation") } do %>
            <%= icon("trash-simple") %>
          <% end %>
        <% end %>
      </div>

      <% if @expenses.any? %>
        <article
          data-elevation="1"
          class="expense-list"
          data-testid="expense-list"
        >
          <h2><%= t(".expenses") %></h2>

          <main>
            <% @expenses_by_date.each do |date, expenses| %>
              <section data-expense-day data-testid="expense-day">
                <header>
                  <h3>
                    <time datetime="<%= date.iso8601 %>"><%= l(date, format: :long) %></time>
                  </h3>

                  <p>
                    <strong data-testid="expense-day-total">
                      <%= formatted_amount(@expense_totals_by_date.fetch(date), @source.currency_code) %>
                      <%= @source.currency_code %>
                    </strong>
                  </p>
                </header>

                <main>
                  <%= render expenses %>
                </main>
              </section>
            <% end %>
          </main>

          <%= render "shared/pagination", page: @page, records_name: t(".expense_records") %>
        </article>
      <% end %>
    </main>
  </article>
</main>
