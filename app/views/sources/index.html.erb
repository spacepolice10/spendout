<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <div>
          <h1>Sources</h1>
        </div>
      </nav>
      Actual remainder:
      <%= formatted_amount(@budget.sources_remainder_in_base, @budget.base_currency_code) %>
    </header>

    <main>
      <% if @sources.any? %>
        <% @sources.each do |source| %>
          <article data-elevation="1" data-testid="source-card">
            <header>
              <nav>
                <%= icon(source.icon) %>
                <h2><%= source.name %></h2>
              </nav>

              <strong><%= formatted_amount(source.spendable_amount, source.currency_code) %></strong>
            </header>

            <footer>
              <%= link_to new_source_exchange_path(source), role: "button", data: { intent: "secondary" } do %>
                <%= icon("coin") %>
                <span>Exchange</span>
              <% end %>

              <%= button_to source_path(source), method: :delete, aria: { label: "Remove source" }, data: { intent: "secondary", turbo_confirm: "Are you sure you want to remove this source?" } do %>
                <%= icon("trash-simple") %>
              <% end %>
            </footer>
          </article>
        <% end %>
      <% else %>
        <article
          data-elevation="1"
          style="border-color: var(--color-accent); color: var(--color-accent);"
        >
          <header>
            <h2>Add your wallets or cards</h2>
          </header>

          <main>
            <p>
              Add a source to track money available to this budget. It might be:
            </p>

            <ul>
              <li>— Your salary</li>
              <li>— A gift</li>
              <li>— A loan</li>
              <li>— A credit card</li>
              <li>— A debit card</li>
              <li>— A bank account</li>
            </ul>

            <p>
              Those will be used on spending with every expense.
            </p>
          </main>
        </article>
      <% end %>

      <% if @exchanges.any? %>
        <article
          data-exchange-list
          data-testid="exchange-list"
          data-elevation="1"
        >
          <header>
            <h2>Exchanges</h2>
          </header>

          <main>
            <% @exchanges_by_date.each do |date, exchanges| %>
              <section data-exchange-day data-testid="exchange-day">
                <header>
                  <h3>
                    <time datetime="<%= date.iso8601 %>"><%= date.to_fs(:long) %></time>
                  </h3>
                </header>

                <main>
                  <%= render partial: "sources/exchange", collection: exchanges %>
                </main>
              </section>
            <% end %>
          </main>

          <%= render "shared/pagination", page: @page, records_name: "exchanges" %>
        </article>
      <% end %>
    </main>

    <footer class="sticky-action-footer">
      <%= link_to new_budget_source_path(@budget), role: "button", data: {
            appearance: "keycap",
            intent: "primary",
            controller: "pressable",
            action: "keydown.shift+s@document->pressable#click"
          } do %>
        <%= icon("plus") %>
        <span>Add source</span>
        <kbd aria-hidden="true">S</kbd>
      <% end %>
    </footer>
  </article>
</main>
