<main data-size="lg">
  <%= tag.p(flash[:notice]) if flash[:notice] %>

  <article data-elevation="1">
    <header>
      <nav>
        <%= link_to icon_tag("chevron-left"), budget_path(@budget), aria: { label: "Back to budget" } %>
        <div>
          <h1>Sources</h1>
        </div>
      </nav>

      <%= link_to icon_tag("plus"), new_budget_source_path(@budget), aria: { label: "New source" } %>
    </header>

    <main>
      <dl>
        <dt>Source totals</dt>
        <dd><%= formatted_amount(@budget.sources_amount_in_base, @budget.base_currency_code) %> <%= @budget.base_currency_code %></dd>
      </dl>
      <% if @sources.any? %>
        <% @sources.each do |source| %>
          <%= link_to source_path(source), style: "color: inherit;" do %>
            <article
              data-elevation="1"
              data-testid="source-card"
              style="<%= colour_styles(source.colour) %>"
            >
              <header>
                <nav>
                  <%= icon_tag(source.icon) %>
                  <h2><%= source.name %></h2>
                </nav>
              </header>

              <main>
                <strong><%= formatted_amount(source.amount, source.currency_code) %></strong>
                <%= source.currency_code %>
              </main>
            </article>
          <% end %>
        <% end %>
      <% else %>
        <h2>No sources yet</h2>
        <p>Add a source to track money available to this budget.</p>
      <% end %>
    </main>
  </article>
</main>
