<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <div>
          <h1><%= t(".name") %></h1>
        </div>
      </nav>
      <%= t(".actual_remainder") %>
      <%= formatted_amount(@budget.sources_remainder_in_base, @budget.base_currency_code) %>
    </header>

    <main>
      <% if @sources.any? %>
        <section data-source-grid aria-label="<%= t(".list_name") %>">
          <%= render @sources %>
        </section>
      <% else %>
        <article
          data-elevation="1"
          style="border-color: var(--color-accent); color: var(--color-accent);"
        >
          <header>
            <h2><%= t(".no_data.name") %></h2>
          </header>

          <main>
            <p>
              <%= t(".no_data.description") %>
            </p>

            <ul>
              <li><%= t(".no_data.salary") %></li>
              <li><%= t(".no_data.gift") %></li>
              <li><%= t(".no_data.loan") %></li>
              <li><%= t(".no_data.credit_card") %></li>
              <li><%= t(".no_data.debit_card") %></li>
              <li><%= t(".no_data.bank_account") %></li>
            </ul>

            <p>
              <%= t(".no_data.spending_explanation") %>
            </p>
          </main>
        </article>
      <% end %>

      <% if @exchanges.any? %>
        <article
          data-exchange-list
          data-testid="exchange-list"
          data-elevation="1"
        >
          <header>
            <h2><%= t(".exchanges") %></h2>
          </header>

          <main>
            <% @exchanges_by_date.each do |date, exchanges| %>
              <section data-exchange-day data-testid="exchange-day">
                <header>
                  <h3>
                    <time datetime="<%= date.iso8601 %>"><%= l(date, format: :long) %></time>
                  </h3>
                </header>

                <main>
                  <%= render partial: "sources/exchange", collection: exchanges %>
                </main>
              </section>
            <% end %>
          </main>

          <%= render "shared/pagination", page: @page, records_name: t(".exchange_records") %>
        </article>
      <% end %>
    </main>
  </article>
</main>

<% content_for :budget_action_footer do %>
  <footer data-budget-action>
    <%= link_to new_budget_source_path(@budget), role: "button", data: {
          appearance: "keycap",
          intent: "primary",
          controller: "pressable",
          action: "keydown.shift+s@document->pressable#click"
        } do %>
      <%= icon("plus") %>
      <span><%= t(".create_source") %></span>
      <kbd aria-hidden="true">S</kbd>
    <% end %>
  </footer>
<% end %>
