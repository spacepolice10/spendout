<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <div>
          <h1>Sources</h1>
        </div>
      </nav>
      Source totals:
      <%= formatted_amount(@budget.sources_amount_in_base, @budget.base_currency_code) %>
    </header>

    <main>
      <% if @sources.any? %>
        <% @sources.each do |source| %>
          <article
            data-elevation="1"
            data-testid="source-card"
            style="<%= colour_styles(source.colour) %>"
          >
            <header>
              <nav>
                <%= icon_tag(source.icon) %>
                <h2><%= source.name %></h2>
              </nav>

              <strong><%= formatted_amount(source.amount, source.currency_code) %></strong>
            </header>

            <footer>
              <%= button_to source_path(source), method: :delete, aria: { label: "Remove source" }, data: { intent: "secondary", turbo_confirm: "Are you sure you want to remove this source?" } do %>
                <%= icon_tag("trash-simple") %>
              <% end %>
            </footer>
          </article>
        <% end %>
      <% else %>
        <article data-elevation="1" style="border-color: var(--color-accent); color: var(--color-accent);">
          <header>
            <h2>Add your wallets or cards</h2>
          </header>

          <main>
            <p>
              Add a source to track money available to this budget. It might be:
            </p>

            <ul>
              <li>— Your salary</li>
              <li>— A gift</li>
              <li>— A loan</li>
              <li>— A credit card</li>
              <li>— A debit card</li>
              <li>— A bank account</li>
            </ul>

            <p>
              Those will be used on spending with every expense.
            </p>
          </main>
        </article>
      <% end %>
    </main>

    <footer>
      <%= link_to new_budget_source_path(@budget), role: "button", data: {
            appearance: "keycap",
            controller: "pressable",
            action: "keydown.shift+s@document->pressable#click"
          } do %>
        <%= icon_tag("plus") %>
        <span>Add source</span>
        <kbd aria-hidden="true">S</kbd>
      <% end %>
    </footer>
  </article>
</main>
