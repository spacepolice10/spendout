<article data-exchange data-testid="exchange-history-item">
  <main>
    <div data-exchange-line>
      <div data-exchange-designs aria-hidden="true">
        <%= render "sources/design", design: Source::DESIGNS.fetch(exchange.sender_source.design),
              colour: exchange.sender_source.colour %>
        <span>→</span>
        <%= render "sources/design", design: Source::DESIGNS.fetch(exchange.receiver_source.design),
              colour: exchange.receiver_source.colour %>
      </div>

      <strong data-exchange-name>
        <span><%= exchange.sender_source.deleted? ? t(".deleted", name: exchange.sender_source.name) : exchange.sender_source.name %></span>
        <span aria-hidden="true">→</span>
        <span><%= exchange.receiver_source.deleted? ? t(".deleted", name: exchange.receiver_source.name) : exchange.receiver_source.name %></span>
      </strong>

      <span data-exchange-amounts>
        <span>
          <strong><%= formatted_amount(exchange.sender_amount, exchange.sender_source.currency_code) %></strong>
          <small><%= exchange.sender_source.currency_code %></small>
        </span>

        <span aria-hidden="true">→</span>

        <span>
          <strong><%= formatted_amount(exchange.receiver_amount, exchange.receiver_source.currency_code) %></strong>
          <small><%= exchange.receiver_source.currency_code %></small>
        </span>
      </span>
    </div>
  </main>
</article>
