<% content_for :title, t(".name") %>

<main data-size="xl" data-anchor="footer">
  <article data-elevation="1" class="budget" data-mobile-lenses>
    <main>
      <% message = @mobile_cybercat_snapshot.featured_message %>
      <% options = message.options.except(:currency_code) %>
      <% options = options.merge(amount: formatted_amount(message.options[:amount], message.options[:currency_code])) if message.options[:amount] %>

      <aside class="cybercat" data-mobile-cybercat data-testid="mobile-cybercat-insight">
        <a href="<%= user_path %>" class="cybercat-face" aria-label="<%= t("users.show.name") %>">
          <%= image_tag "cybercat.png", alt: t("lenses.cybercat.description"), width: 64, height: 64 %>
        </a>
        <p class="cybercat-text"><%= t("lenses.cybercat.messages.#{message.key}", **options) %></p>
      </aside>

      <section aria-label="<%= t(".lenses") %>" data-mobile-lens-section>
        <header>
          <%= link_to edit_budget_lenses_path(@budget), role: "button", data: { intent: "secondary", size: "sm" } do %>
            <%= icon("settings") %>
            <span><%= t(".configure") %></span>
          <% end %>
        </header>

        <div data-mobile-lens-carousel data-controller="lens-carousel" data-action="scroll->lens-carousel#persist turbo:before-cache@document->lens-carousel#persist">
          <% @mobile_widget_lenses.each do |lens| %>
            <article data-elevation="1" data-lens>
              <main>
                <% if (snapshot = @snapshots_by_lens_id[lens.id]) %>
                  <%= render "lenses/#{lens.lensable_name}", lens:, snapshot: %>
                <% else %>
                  <p><%= t(".inactive") %></p>
                <% end %>
              </main>

              <%= render "lenses/controls", lens:, snapshot: @snapshots_by_lens_id[lens.id] %>
            </article>
          <% end %>
        </div>
      </section>

      <section aria-labelledby="mobile-recent-title" data-mobile-recent-records>
        <header>
          <h1 id="mobile-recent-title"><%= t(".recent_records") %></h1>
        </header>
        <%= render "records/timeline", page: @page, snapshot: @timeline %>
      </section>
    </main>
  </article>
</main>
<% content_for :add_menu do %>
  <%= render "shared/add_menu" %>
<% end %>
