<article data-elevation="2" data-testid="tiny-leaks-lens"><main><% if snapshot.records.any? %><ol><% snapshot.records.each do |record| %><li><%= icon(record.category.icon, style: icon_colour_styles(record.category.colour)) %><strong><%= record.label %></strong><span><%= record.occurrences %> × · <%= formatted_amount(record.amount, snapshot.currency_code) %></span></li><% end %></ol><p><%= t("lenses.tiny_leaks.total", amount: formatted_amount(snapshot.total, snapshot.currency_code), currency: snapshot.currency_code) %></p><% else %><p><%= t("lenses.tiny_leaks.empty") %></p><% end %></main></article>
