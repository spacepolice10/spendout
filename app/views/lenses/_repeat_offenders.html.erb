<article data-elevation="2" data-testid="repeat-offenders-lens"><main><% if snapshot.records.any? %><ol><% snapshot.records.each do |record| %><li><%= icon(record.category.icon, style: icon_colour_styles(record.category.colour)) %><strong><%= record.label %></strong><span><%= t("lenses.repeat_offenders.pattern", count: record.occurrences, days: record.period_days) %></span><small><%= t("lenses.repeat_offenders.next", date: l(record.next_on, format: :long)) %></small></li><% end %></ol><% else %><p><%= t("lenses.repeat_offenders.empty") %></p><% end %></main></article>
