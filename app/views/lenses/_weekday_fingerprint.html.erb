<article data-elevation="2" data-testid="weekday-fingerprint-lens"><main><ol><% snapshot.days.each do |day| %><li><strong><%= I18n.t("date.day_names")[day.wday] %></strong><span><%= formatted_amount(day.average, snapshot.currency_code) %></span><small><%= day.expense_count %></small></li><% end %></ol><% if snapshot.highest&.average&.positive? %><p><%= t("lenses.weekday_fingerprint.highest", day: I18n.t("date.day_names")[snapshot.highest.wday]) %></p><% else %><p><%= t("lenses.weekday_fingerprint.empty") %></p><% end %></main></article>
