<article data-elevation="2" data-testid="payday-gravity-lens"><main><% if snapshot.records.any? %><ol><% snapshot.records.each do |record| %><li><strong><%= record.income.source_name %></strong><span><%= t("lenses.payday_gravity.spent", percentage: record.percentage.round, days: record.days) %></span><small><%= formatted_amount(record.spent, snapshot.currency_code) %> / <%= formatted_amount(record.income_amount, snapshot.currency_code) %></small></li><% end %></ol><% else %><p><%= t("lenses.payday_gravity.empty") %></p><% end %></main></article>
