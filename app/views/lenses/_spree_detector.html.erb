<article data-elevation="2" data-testid="spree-detector-lens"><main><% if snapshot.days.any? %><ol><% snapshot.days.each do |day| %><li><time datetime="<%= day.date.iso8601 %>"><%= l(day.date, format: :long) %></time><strong><%= formatted_amount(day.amount, snapshot.currency_code) %></strong><small><%= t("lenses.spree_detector.multiple", multiple: day.multiple.round(1)) %></small></li><% end %></ol><% else %><p><%= t("lenses.spree_detector.empty") %></p><% end %></main></article>
