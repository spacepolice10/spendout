<% content_for :title, "Spendout — Everyday money, under control" %>
<% content_for :description, "A simple budget that turns your plans, currencies, and expenses into one answer: what is safe to spend today?" %>
<% content_for :hide_tabbar, true %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Handjet:wght@400;600&amp;family=Silkscreen:wght@700&amp;display=swap">
<% end %>

<a href="#main-content" data-skip-link>Skip to content</a>

<%= render "shared/header" %>

<main id="main-content" data-page="landing" data-size="xl">
  <section data-landing-hero aria-labelledby="landing-title">
    <div>
      <h1 id="landing-title">Know what you can spend.</h1>

      <p>
        Spendout turns wallets, plans, and everyday spending into one answer:
        <strong>what's safe to spend today.</strong> No subscription. No lock-in.
        Run it yourself. And it has looks, by the way.
      </p>

      <div data-landing-actions>
        <%= link_to authenticated? ? "Open my budget" : "Try Spendout", authenticated? ? root_path : new_session_path,
              role: "button", data: { appearance: "keycap", intent: "primary" } %>
      </div>

      <p data-landing-price>$0 · self-hosted · your server, your data</p>
    </div>
  </section>

  <section data-landing-chapter aria-labelledby="control-title">
    <header>
      <h2 id="control-title">Your daily fuel gauge.</h2>

      <p>
        One glance tells you how much unplanned money is safe to spend today.
      </p>
    </header>

    <div data-control-layout>
      <article class="budget" data-landing-fuel data-gauge-plate>
        <div data-gauge-bolts aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <%= render "shared/daily_gauge", amount: 74, currency_code: "USD", percentage: 68 %>
      </article>

      <div data-control-notes data-rate-copy>
        <article>
          <h3>A signal. Never a gate.</h3>

          <p>
            Spend less today, tomorrow's number grows. Spend more, the meter
            adjusts. Money for rent and bills is set aside first and
            <strong>never touches this number</strong> — over-planning gets a
            warning, not a lock.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section data-landing-chapter aria-labelledby="currency-title">
    <header>
      <h2 id="currency-title">Speaks your currency.</h2>

      <p>
        Choose the currency that fits the money in front of you, exchange
        between wallet-like sources, and still see one useful budget total.
      </p>
    </header>

    <% sample_rates = [
      { code: "EUR", name: "Euro", rate: "0.8929" },
      { code: "CAD", name: "Canadian dollar", rate: "1.3800" },
      { code: "JPY", name: "Japanese yen", rate: "147.20" },
      { code: "VND", name: "Vietnamese dong", rate: "26,300" }
    ] %>

    <div data-currency-story>
      <section
        data-rate-board
        aria-labelledby="rate-board-title"
      >
        <header>
          <p data-rate-board-status>Sample rates</p>
          <h3 id="rate-board-title">Exchange rates</h3>
        </header>

        <table>
          <caption>
            Spendout suggests dated reference rates for review. You confirm the
            direct quote before anything is saved.
          </caption>
          <thead>
            <tr>
              <th scope="col">Currency</th>
              <th scope="col">Rate</th>
            </tr>
          </thead>
          <tbody>
            <% sample_rates.each do |row| %>
              <tr>
                <th scope="row">
                  <strong data-rate-code><%= row[:code] %></strong>
                  <span data-rate-name><%= row[:name] %></span>
                </th>
                <td>
                  <output data-rate-display><%= row[:rate] %></output>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <div data-rate-copy>
        <article>
          <h3>Real currencies. Honest history.</h3>

          <p>
            Keep each source and purchase in its real currency while your
            budget's base currency stays fixed. Exchange money between sources
            and both sides remain together in your history. Reference rates are
            dated, editable suggestions you confirm —
            <strong>saved amounts never revalue themselves.</strong>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="details" data-landing-chapter aria-labelledby="details-title">
    <header>
      <h2 id="details-title">Features</h2>
      <p>A closer look at how Spendout works, screen by screen.</p>
    </header>

    <%= render "home/feature_chips" %>

    <div data-landing-actions>
      <%= link_to "Take the tour", tour_path(feature: Tour::FEATURES.keys.first),
            role: "button", data: { appearance: "keycap", intent: "primary" } %>
    </div>
  </section>

  <section data-landing-letter aria-labelledby="letter-title">
    <article>
      <header>
        <p>A note from the maker</p>
        <h2 id="letter-title">Why I made Spendout</h2>
      </header>

      <p>Hello,</p>

      <p>
        I created Spendout because I wanted to make expense tracking simple,
        free, and reasonable, without depending on huge SaaS products or
        building another spreadsheet.
      </p>

      <p>
        I have a passion for building web software in a traditional fashion,
        using the modern Rails stack. Spendout makes it quick to record
        expenses, handle exchanges, and categorize payments in any browser,
        without being tied to a platform or app store. Its open nature makes
        it easy to modify any part of the app to suit specific requirements.
        If you want to try something new, you can explore Spendout while
        keeping control of both your financial data and the application that
        helps manage it.
      </p>

      <footer>
        <p>— Vlad Kov</p>
      </footer>
    </article>
  </section>

  <section data-landing-ownership aria-labelledby="ownership-title">
    <div>
      <h2 id="ownership-title">Built to be self-hosted.</h2>

      <p>
        Spendout is a compact Rails application currently deployed with Kamal.
        An ONCE-ready version adds guided first-run administrator setup, managed
        HTTPS, updates, persistent storage, and backup and restore hooks.
      </p>

      <%= link_to "Install with ONCE", once_path %>
    </div>

    <aside data-deployment-terminal aria-label="Deployment terminal">
      <header data-terminal-bar>
        <span data-terminal-pills aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>

        <small>deploy · your.server</small>
      </header>

      <div data-terminal-body>
        <p data-terminal-comment># deploy Spendout to your server</p>
        <p data-terminal-command>$ kamal deploy</p>
        <p data-terminal-ok><i>✓</i><span>Spendout is running</span></p>

        <hr data-terminal-rule>

        <p data-terminal-comment># guided self-hosting with ONCE</p>
        <p data-terminal-command>$ once deploy ghcr.io/spacepolice10/spendout:latest \\</p>
        <p data-terminal-output>  --host spendout.example.com</p>

        <p data-terminal-prompt>
          <span data-terminal-command>$</span>
          <span data-terminal-cursor aria-hidden="true"></span>
        </p>
      </div>

      <footer data-terminal-foot>
        <span data-terminal-live aria-hidden="true"></span>
        <small>1 app · SQLite · no add-ons</small>
      </footer>
    </aside>
  </section>

  <footer data-landing-footer>
    <p>
      <strong>Demo data is temporary.</strong> It is not preserved and may be
      removed within a week.
    </p>

    <%= link_to authenticated? ? "Open my budget" : "Try the demo", authenticated? ? root_path : new_session_path,
          role: "button", data: { appearance: "keycap", intent: "primary" } %>
  </footer>

</main>
