<% content_for :title, "Spendout — Everyday money, under control" %>
<% content_for :description, "A simple budget that turns your plans, currencies, and expenses into one answer: what is safe to spend today?" %>
<% content_for :hide_tabbar, true %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Handjet:wght@400;600&amp;family=Silkscreen:wght@700&amp;display=swap">
<% end %>

<a href="#main-content" data-skip-link>Skip to content</a>

<main id="main-content" data-page="landing" data-size="xl">
  <section data-landing-hero aria-labelledby="landing-title">
    <div>
      <header data-hero-cybercat>
        <%= image_tag "cybercat.png", alt: "Cybercat", width: 100 %>

        <h1>Spendout</h1>
      </header>

      <h2 id="landing-title">Know what you can spend.<br>Everyday.</h2>

      <p>
        Spendout keeps your wallets, important plans, and everyday expenses in
        one calm instrument panel.
      </p>

      <div data-landing-actions>
        <%= link_to authenticated? ? "Open my budget" : "Try Spendout", authenticated? ? root_path : new_session_path,
              role: "button", data: { appearance: "keycap", intent: "primary" } %>
      </div>
    </div>
  </section>

  <section
    id="how-it-works"
    data-landing-chapter
    aria-labelledby="simple-title"
  >
    <header>
      <h2 id="simple-title">Money, but simple.</h2>

      <p>
        A budget should answer questions. How much I have? What needs to be covered? How much is safe to spend today? Spendout keeps answering those questions.
      </p>
    </header>

    <div data-landing-steps>
      <article data-elevation="1">
        <header>
          <span>01</span>
          <h3>Add your money</h3>
        </header>

        <main>
          <p>
            Bring together cash, cards, bank accounts, or any other source you
            actually spend from.
          </p>

          <div data-mini-source>
            <span></span><span>Everyday card</span><strong>$2,140</strong>
            <span></span><span>Cash</span><strong>$19</strong>
          </div>
        </main>
      </article>

      <article data-elevation="1">
        <header>
          <span>02</span>
          <h3>Protect your plans</h3>
        </header>

        <main>
          <p>
            Set aside rent, bills, and savings first. Plans guide you without
            blocking a real expense.
          </p>

          <div data-mini-plan>
            <span>Rent</span><strong>$1,200 / $1,200</strong>
            <progress value="100" max="100">100%</progress>
          </div>
        </main>
      </article>

      <article data-elevation="1">
        <header>
          <span>03</span>
          <h3>Record what happened</h3>
        </header>

        <main>
          <p>
            Choose the source, optionally classify it, and move on. The
            dashboard recalculates immediately.
          </p>

          <div data-mini-expense>
            <span>🍔</span><span>Coffee</span><strong>−$4.50</strong><small>Today · Everyday card</small>
          </div>
        </main>
      </article>
    </div>
  </section>

  <section data-landing-chapter aria-labelledby="control-title">
    <header>
      <h2 id="control-title">Your daily fuel gauge.</h2>

      <p>
        One glance tells you how much unplanned money is safe to spend today. <strong>Driving the level of stress down and keeping you calm</strong>.
      </p>
    </header>

    <div data-control-layout>
      <article class="budget" data-landing-fuel>
        <%= render "shared/daily_gauge", amount: 74, currency_code: "USD", percentage: 68 %>
      </article>

      <div data-control-notes>
        <article>
          <span aria-hidden="true">🎢</span>

          <div>
            <h3>Unused money rolls forward</h3>

            <p>
              Spend less today and tomorrow's safe remainder grows. Spend more
              and the meter adjusts.
            </p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">🛡️</span>

          <div>
            <h3>Plans stay protected</h3>

            <p>
              Spending assigned to rent, bills, or another planned category does
              not consume the everyday remainder.
            </p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">🚦</span>

          <div>
            <h3>A signal, never a gate</h3>

            <p>
              Over-planning produces a warning, not a lock. Spendout informs
              your decision and stays out of the way.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section data-landing-chapter aria-labelledby="currency-title">
    <header>
      <h2 id="currency-title">Currency polyglot.</h2>

      <p>
        Choose the currency that fits the money in front of you, exchange
        between wallet-like sources, and still see one useful budget total.
      </p>
    </header>

    <% rate_snapshots = [
      {
        base: "USD",
        rows: [
          { code: "EUR", name: "Euro", rate: "0.8929" },
          { code: "CAD", name: "Canadian dollar", rate: "1.3800" },
          { code: "GBP", name: "Pound sterling", rate: "0.7450" },
          { code: "JPY", name: "Japanese yen", rate: "147.20" },
          { code: "VND", name: "Vietnamese dong", rate: "26,300" }
        ]
      },
      {
        base: "EUR",
        rows: [
          { code: "USD", name: "US dollar", rate: "1.1200" },
          { code: "CAD", name: "Canadian dollar", rate: "1.5455" },
          { code: "GBP", name: "Pound sterling", rate: "0.8344" },
          { code: "JPY", name: "Japanese yen", rate: "164.86" },
          { code: "VND", name: "Vietnamese dong", rate: "29,454.59" }
        ]
      }
    ] %>

    <div data-currency-story>
      <section
        data-rate-board
        data-controller="rate-board"
        data-rate-board-snapshots-value="<%= rate_snapshots.to_json %>"
        aria-labelledby="rate-board-title"
        tabindex="0"
      >
        <header>
          <p data-rate-board-status>Sample rates</p>
          <h3 id="rate-board-title">Exchange rates</h3>
        </header>

        <table>
          <caption>
            Spendout suggests dated reference rates for review. You confirm the
            direct quote before anything is saved.
          </caption>
          <thead>
            <tr>
              <th scope="col">Currency</th>
              <th scope="col">Rate</th>
            </tr>
          </thead>
          <tbody>
            <% rate_snapshots.first[:rows].each do |row| %>
              <tr data-rate-board-target="row">
                <th scope="row">
                  <strong data-rate-code><%= row[:code] %></strong>
                  <span data-rate-name><%= row[:name] %></span>
                </th>
                <td>
                  <output data-rate-board-target="rate" data-rate-display><%= row[:rate] %></output>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <div data-rate-copy>
        <article>
          <p data-rate-copy-number>01</p>
          <h3>Use the currency in front of you</h3>
          <p>
            Keep cash, sources, and purchases in their real currencies while
            the budget's base currency stays fixed.
          </p>
        </article>

        <article>
          <p data-rate-copy-number>02</p>
          <h3>Exchange into another wallet</h3>
          <p>
            An exchange debits one source and creates another in the new
            currency. Both sides stay together in your history.
          </p>
        </article>

        <article>
          <p data-rate-copy-number>03</p>
          <h3>Easy conversions, honest rates</h3>
          <p>
            Pick a currency in the searchable dialog, review the editable,
            dated Frankfurter suggestion, and confirm the direct quote.
            <strong>Historical amounts never revalue themselves.</strong>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="details" data-landing-chapter aria-labelledby="details-title">
    <header>
      <h2 id="details-title">Fast when you know what you want.</h2>
      <p>Friendly defaults for beginners. Short paths for everyone else.</p>
    </header>

    <div data-detail-grid>
      <article>
        <div><kbd>⇧</kbd><span>+</span><kbd>E</kbd></div>
        <h3>Keyboard friendly</h3>

        <p>
          Jump between sections and add an expense without reaching for the
          pointer.
        </p>
      </article>

      <article>
        <div><span>⌖</span><strong>VND</strong></div>
        <h3>Currency suggested</h3>

        <p>
          Your timezone brings the likely currency forward without silently
          choosing it.
        </p>
      </article>

      <article>
        <div><span>Aug 24</span><span>→</span><span>Aug 22</span></div>
        <h3>Easy to correct</h3>

        <p>
          Edit the amount, note, category, source, or occurrence date when
          reality changes.
        </p>
      </article>

      <article>
        <div><span>Rent</span><span>·</span><span>Deleted source</span></div>
        <h3>History stays honest</h3>

        <p>
          Removed sources and categories remain visible on the expenses that
          used them.
        </p>
      </article>
    </div>
  </section>

  <section data-landing-ownership aria-labelledby="ownership-title">
    <div>
      <h2 id="ownership-title">Built to be self-hosted.</h2>

      <p>
        Spendout is a compact Rails application currently deployed with Kamal. A
        simpler guided installation with ONCE is planned.
      </p>

      <a href="https://github.com/spacepolice10/spendout">View the source on GitHub ↗</a>
    </div>

    <aside data-deployment-terminal aria-label="Deployment terminal">
      <header>
        <span aria-hidden="true">● ● ●</span><small>spendout@server:~</small>
      </header>

      <div>
        <p><span>$</span> kamal deploy</p>
        <p><strong>✓</strong> Spendout is running</p>
        <p><span>$</span> once deploy spendout</p>
        <p><small>↳ planned: guided install + backups</small></p>
      </div>
    </aside>
  </section>

  <footer data-landing-footer>
    <div>
      <strong>Spendout</strong>
      <p>A quieter way to decide what is safe to spend.</p>
    </div>

    <p>
      <strong>ROADMAP</strong> · Reports · CLI access · Automatic sorting
      <small>— planned, not yet available</small>
    </p>

    <%= link_to authenticated? ? "Open my budget" : "Try Spendout", authenticated? ? root_path : new_session_path, role: "button", data: { appearance: "keycap", intent: "primary" } %>
  </footer>
</main>
