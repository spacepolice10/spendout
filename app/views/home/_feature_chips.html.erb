<nav data-feature-chips aria-label="Feature tour">
  <div data-feature-chip-cloud>
    <% Tour::FEATURES.each do |slug, feature| %>
      <%= link_to tour_path(feature: slug) do %>
        <%= icon(feature[:icon]) %>
        <span><%= feature[:chip] %></span>
      <% end %>
    <% end %>
  </div>
</nav>
