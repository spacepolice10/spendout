<section data-tour-slide="welcome" aria-labelledby="welcome-title">
  <article data-tour-copy>
    <p data-tour-count>Spendout, screen by screen</p>
    <h1 id="welcome-title">Know what you can spend.<br>See exactly why.</h1>
    <p data-tour-lead>Nine pages take a closer look at every feature highlighted on the landing page.</p>
  </article>

  <nav data-tour-next aria-label="Begin tour">
    <%= link_to tour_path(feature: HomeController::TOUR_FEATURES.keys.first) do %>
      Start the tour <span aria-hidden="true">→</span>
    <% end %>
  </nav>
</section>
