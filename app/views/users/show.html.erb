<% content_for :title, t(".name") %>

<main data-size="sm" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <%= render "shared/back",
              path: @budget ? budget_lenses_path(@budget) : root_path,
              label: t(".back") %>

        <h1><%= t(".name") %></h1>
      </nav>
    </header>

    <main>
      <section>
        <h2><%= t(".account") %></h2>
        <p><%= Current.user.email_address %></p>
      </section>

      <% if @budget %>
      <section>
        <h2><%= t(".budget") %></h2>
        <p><%= t(".budget_description") %></p>
      </section>
      <% end %>

      <%= button_to t(".sign_out"), session_path, method: :delete,
              data: { intent: "primary" } %>

<% if @budget %>
<%= button_to t(".remove_budget"), budget_path(@budget), method: :delete,
                data: {
                  intent: "negative",
                  turbo_confirm: t(".remove_budget_confirmation")
                } %>
      <% end %>
    </main>
  </article>
  <%= render "shared/locale_switcher" %>
</main>
