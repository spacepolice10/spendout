<% content_for :title, "User" %>

<main data-size="sm" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <h1>User</h1>
      </nav>
    </header>

    <main>
      <section>
        <h2>Account</h2>
        <p><%= Current.user.email_address %></p>
      </section>

      <% if @budget %>
        <section>
          <h2>Budget</h2>
          <p>Removing your budget permanently deletes its sources, allocations, expenses, and exchanges.</p>
        </section>
      <% end %>

    </main>

    <footer>
      <nav aria-label="User actions" style="display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-v) var(--space-h);">
        <%= button_to "Sign out", session_path, method: :delete %>

        <% if @budget %>
          <%= button_to "Remove budget", budget_path(@budget), method: :delete,
                data: {
                  intent: "negative",
                  turbo_confirm: "Remove this budget and all of its data permanently? This cannot be undone."
                } %>
        <% end %>
      </nav>
    </footer>
  </article>
</main>
