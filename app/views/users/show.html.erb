<% content_for :title, "User" %>

<main data-size="sm">
  <article data-elevation="1">
    <header>
      <nav>
        <h1>User</h1>
      </nav>
    </header>

    <main>
      <section>
        <h2>Account</h2>
        <p><%= Current.user.email_address %></p>
      </section>

      <% if Current.user.administrator? %>
        <section>
          <h2>Administration</h2>
          <p>Add people who may use this Spendout installation.</p>
          <%= link_to "Manage users", admin_users_path %>
        </section>
      <% end %>

      <% if @budget %>
        <section>
          <h2>Budget</h2>
          <p>Removing your budget permanently deletes its sources, allocations, expenses, and exchanges.</p>

          <div style="display:flex;justify-content:center;margin-block-start:var(--space-v-2);">
            <%= button_to "Remove budget", budget_path(@budget), method: :delete,
                  data: {
                    intent: "negative",
                    turbo_confirm: "Remove this budget and all of its data permanently? This cannot be undone."
                  } %>
          </div>
        </section>
      <% end %>
    </main>
  </article>
</main>
