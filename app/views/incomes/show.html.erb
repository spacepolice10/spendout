<main data-size="sm"><article data-elevation="1"><header><h1><%= @income.source_name %></h1><strong><%= formatted_amount(@income.amount, @income.currency_code) %> <%= @income.currency_code %></strong></header><main><p><%= @income.source.name %></p><time datetime="<%= @income.occurred_on.iso8601 %>"><%= l(@income.occurred_on, format: :long) %></time><p><%= @income.note %></p></main><footer><%= button_to t(".delete"), income_path(@income), method: :delete, data: { intent: "negative", turbo_confirm: t(".delete_confirmation") } %></footer></article></main>
