<%= form_with model: [ budget, allocation ], data: { allocation_form: true } do |form| %>
  <% if allocation.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(allocation.errors.count, "error") %> prevented this allocation
        from being saved:
      </h2>

      <ul>
        <% allocation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form.label :name %>
  <%= form.text_field :name, required: true, autofocus: true %>

  <%= form.label :amount %>
  <%= form.text_field :amount, inputmode: "decimal", placeholder: "0", required: true,
        data: {
          controller: "money-input",
          money_input_start_value: allocation.amount&.to_s("F")
        } %>

  <%= form.label :currency_code, "Currency" %>
  <%= form.select :currency_code,
        budget.currencies.map { |currency| [ currency.option_name, currency.alphabetic_code ] },
        { include_blank: "Choose a currency" }, required: true %>

  <%= render "shared/appearance_fields", form: form %>

  <%= form.submit %>
<% end %>
