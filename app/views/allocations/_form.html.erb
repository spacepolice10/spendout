<%= form_with model: [ budget, allocation ], data: {
      allocation_form: true,
      controller: "currency-conversion",
      currency_conversion_base_currency_value: budget.base_currency_code
    } do |form| %>
  <% if allocation.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(allocation.errors.count, "error") %> prevented this
        allocation from being saved:
      </h2>

      <ul>
        <% allocation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/name_fields", form: form, placeholder: "Rent, groceries, emergency fund, etc." %>
  <%= render "shared/amount_fields", form: form, amount_attribute: :amount %>

  <%= render "shared/currency_fields", form: form,
        currency_attribute: :currency_code, rate_attribute: :rate,
        base_currency_code: budget.base_currency_code %>

  <%= render "shared/icon_fields", form: form %>
  <%= render "shared/colour_fields", form: form %>

  <div data-layout="flex">
    <%= link_to budget_allocations_path(budget), role: "button", data: {
          appearance: "keycap", intent: "secondary", size: "lg",
          controller: "pressable", action: "keydown.shift+esc@document->pressable#click"
        } do %>
      <%= icon_tag("chevron-left") %>
      <span>Cancel</span>
      <kbd aria-hidden="true">Shift + Escape</kbd>
    <% end %>
    <%= form.button type: "submit", data: {
          appearance: "keycap", intent: "primary", size: "lg",
          controller: "pressable", action: "keydown.meta+enter@document->pressable#click"
        } do %>
      <span>Confirm</span>
      <%= icon_tag("chevron-right") %>
      <kbd aria-hidden="true">Cmd + Enter</kbd>
    <% end %>
  </div>
<% end %>
