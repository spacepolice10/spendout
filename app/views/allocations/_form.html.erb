<%= form_with model: [ budget, allocation ], data: {
      allocation_form: true,
      controller: "form category-icon",
      category_icon_keywords_value: CategoryIcon::KEYWORDS,
      category_icon_colours_value: CategoryIcon::COLOURS
    } do |form| %>
  <% if allocation.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= t(".errors", count: allocation.errors.count) %>
      </h2>

      <ul>
        <% allocation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/name_fields", form:, name_attribute: :category_name_to_create,
        question: t(".name_question"), placeholder: t(".name_placeholder"),
        input_data: { category_icon_target: "name", action: "input->category-icon#suggest" } %>
  <%= render "shared/icon_fields", form:, icon_attribute: :category_icon,
        icon_options: Category.icon_options, icon_value: allocation.category_icon || Iconable::DEFAULT_ICON,
        input_data: { category_icon_target: "icon", action: "input->category-icon#chooseIcon" } %>
  <%= render "shared/colour_fields", form:, colour_attribute: :category_colour,
        colour_options: Category.colour_options, colour_value: allocation.category_colour || Colourable::DEFAULT_COLOUR,
        input_data: { category_icon_target: "colour", action: "input->category-icon#chooseColour" } %>
  <%= render "shared/amount_with_currency_fields", form: form %>

  <%= render "shared/form_actions", form:, cancel_path: budget_lenses_path(budget),
        cancel_label: t(".cancel"), submit_label: t(".submit") %>
<% end %>
