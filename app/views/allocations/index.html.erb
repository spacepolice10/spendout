<main data-size="lg" data-anchor="footer">
  <article data-elevation="1">
    <header>
      <nav>
        <div>
          <h1><%= t(".name") %></h1>
        </div>
      </nav>
      <p data-testid="budget-remainder">
        <%= t(".remainder", amount: formatted_amount(@budget.amount_summary, @budget.base_currency_code), currency: @budget.base_currency_code) %>
      </p>
    </header>

    <main>
      <% if @budget.overallocated? %>
        <p role="status" data-testid="overallocation-warning">
          <%= t(".overallocation", amount: formatted_amount(@budget.overallocated_by, @budget.base_currency_code), currency: @budget.base_currency_code) %>
        </p>
      <% end %>

      <% if @allocations.any? %>
        <%= render partial: "allocation", collection: @allocations, locals: { budget: @budget } %>
      <% else %>
        <article data-elevation="1" style="border-color: var(--color-accent); color: var(--color-accent);">
          <header>
            <h2><%= t(".no_data.name") %></h2>
          </header>

          <main>
            <p>
              <%= t(".no_data.description") %>
              <ul>
                <li><%= t(".no_data.rent") %></li>
                <li><%= t(".no_data.utilities") %></li>
                <li><%= t(".no_data.bill") %></li>
                <li><%= t(".no_data.emergency_fund") %></li>
              </ul>
              <%= t(".no_data.spending_explanation") %>
            </p>
          </main>
        </article>
      <% end %>
    </main>
  </article>
</main>

<% content_for :budget_action_footer do %>
  <footer data-budget-action>
    <%= link_to new_budget_allocation_path(@budget), role: "button", data: {
          appearance: "keycap",
          intent: "primary",
          controller: "pressable",
          action: "keydown.shift+c@document->pressable#click"
        } do %>
      <%= icon("plus") %>
      <span><%= t(".create_allocation") %></span>
      <kbd aria-hidden="true">C</kbd>
    <% end %>
  </footer>
<% end %>
