<% used_amount = allocation.used_amount %>
<% progress_maximum = allocation.amount.positive? ? allocation.amount : 1 %>
<% progress_amount = allocation.amount.positive? ? [ used_amount, allocation.amount ].min : (used_amount.positive? ? 1 : 0) %>

<%= tag.article data: {
      elevation: "1",
      testid: "allocation-card",
      allocation_card: true,
      finished_allocation: allocation.finished? || nil
    } do %>
  <% if allocation.finished? %>
    <mark data-finished-stamp><%= t(".finished") %></mark>
  <% end %>

  <header>
    <nav>
      <span data-allocation-envelope-thumbnail>
        <%= render "allocations/envelope", variant: "closed" %>
        <%= icon(allocation.icon, style: icon_colour_styles(allocation.colour)) %>
      </span>
      <h2><%= allocation.name %></h2>
    </nav>

    <strong><%= formatted_amount(allocation.amount, allocation.currency_code) %></strong>
  </header>

  <main>
    <progress
      value="<%= progress_amount %>"
      max="<%= progress_maximum %>"
      aria-label="<%= t(".spending", used: formatted_amount(used_amount, allocation.currency_code), planned: formatted_amount(allocation.amount, allocation.currency_code)) %>"
      style="--progress-colour: var(--color-palette-<%= allocation.colour %>);"
      data-testid="allocation-progress"
    ></progress>

    <small>
      <%= t(".spending", used: formatted_amount(used_amount, allocation.currency_code), planned: formatted_amount(allocation.amount, allocation.currency_code)) %>
      <% if used_amount > allocation.amount %>
        <%= t(".over_plan", amount: formatted_amount(used_amount - allocation.amount, allocation.currency_code)) %>
      <% end %>
    </small>

    <% if allocation.rate != 1 %>
      <%= t(".rate", rate: allocation.rate, base_currency: budget.base_currency_code, currency: allocation.currency_code) %>
    <% end %>
  </main>

  <footer>

    <%= link_to allocation_path(allocation), role: "button", data: { intent: "secondary" } do %>
      <%= icon("history") %>
      <span><%= t(".details") %></span>
    <% end %>

    <% if allocation.finished? %>
      <% unless budget.archived? %>
        <%= button_to t(".reopen"), reopen_allocation_path(allocation), method: :patch,
              data: { turbo_confirm: t(".reopen_confirmation", name: allocation.name) } %>
      <% end %>
    <% else %>
      <%= button_to t(".finish"), finish_allocation_path(allocation), method: :patch, data: {
            intent: "primary",
            turbo_confirm: t(".finish_confirmation", name: allocation.name, amount: formatted_amount(allocation.remaining_amount, allocation.currency_code))
          } %>
    <% end %>
  </footer>
<% end %>
