<main data-size="sm">
  <article data-elevation="1" style="<%= colour_styles(@allocation.colour) %>">
    <header>
      <nav>
        <%= link_to icon_tag("chevron-left"), budget_allocations_path(@budget), aria: { label: "Back to allocations" } %>
        <%= icon_tag(@allocation.icon) %>
        <h1><%= @allocation.name %></h1>
      </nav>
      <small><%= "Deleted" if @allocation.deleted? %></small>
    </header>

    <%= tag.p(flash[:notice]) if flash[:notice] %>

    <main>
      <dl>
        <dt>Amount</dt>
        <dd><%= formatted_amount(@allocation.amount, @allocation.currency) %> <%= @allocation.currency_code %></dd>
        <dt>Source</dt>
        <dd>
          <%= link_to @allocation.source.name, source_path(@allocation.source) %>
          <%= "(Deleted)" if @allocation.source.deleted? %>
        </dd>
        <dt>Budget</dt>
        <dd><%= link_to @budget.name, budget_path(@budget) %></dd>
      </dl>
    </main>
  </article>
</main>
