<main data-size="sm" data-anchor="footer">
  <article data-elevation="1" style="<%= colour_styles(@allocation.colour) %>">
    <header>
      <nav>
        <%= link_to icon("chevron-left"), budget_allocations_path(@budget), aria: { label: "Back to allocations" } %>
        <%= icon(@allocation.icon) %>
        <h1><%= @allocation.name %></h1>
      </nav>
      <small><%= @allocation.deleted? ? "Deleted" : ("Finished" if @allocation.finished?) %></small>
    </header>

    <main>
      <dl>
        <dt>Amount</dt>
        <dd><%= formatted_amount(@allocation.amount, @allocation.currency_code) %> <%= @allocation.currency_code %></dd>
        <dt>Budget</dt>
        <dd><%= link_to @budget.date_period, budget_expenses_path(@budget) %></dd>
      </dl>
    </main>

    <% if @allocation.finished? && !@allocation.deleted? && !@budget.archived? %>
      <footer>
        <%= button_to "Reopen allocation", reopen_allocation_path(@allocation), method: :patch,
              data: { turbo_confirm: "Reopen #{@allocation.name} and reserve its remaining amount again?" } %>
      </footer>
    <% end %>
  </article>
</main>
