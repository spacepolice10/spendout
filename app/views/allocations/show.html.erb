<% content_for :title, @allocation.name %>

<main data-size="lg" data-anchor="footer">
  <article>
    <main>
      <div data-allocation-hero>
        <%= render "allocations/envelope", variant: "open" %>
        <%= icon(@allocation.icon, style: icon_colour_styles(@allocation.colour)) %>
      </div>

      <hgroup data-allocation-title>
        <h1><%= @allocation.name %></h1>
        <small><%= @allocation.deleted? ? t(".deleted") : (t(".finished") if @allocation.finished?) %></small>
      </hgroup>

      <section aria-label="<%= t(".summary_name") %>" data-allocation-summary>
        <p>
          <% if @allocation.planned? %>
            <span>
              <%= t(".planned") %>
              <strong><%= formatted_amount(@allocation.amount, @allocation.currency_code) %> <%= @allocation.currency_code %></strong>
            </span>
            <span aria-hidden="true">·</span>
            <span>
              <%= t(".used") %>
              <strong><%= formatted_amount(@allocation.used_amount, @allocation.currency_code) %> <%= @allocation.currency_code %></strong>
            </span>
            <span aria-hidden="true">·</span>
            <span>
              <%= t(".remaining") %>
              <strong><%= formatted_amount(@allocation.remaining_amount, @allocation.currency_code) %> <%= @allocation.currency_code %></strong>
            </span>
          <% else %>
            <span><%= t(".unplanned") %></span>
            <span aria-hidden="true">·</span>
            <span>
              <%= t(".used") %>
              <strong><%= formatted_amount(@allocation.used_amount, @allocation.currency_code) %> <%= @allocation.currency_code %></strong>
            </span>
          <% end %>
        </p>
      </section>

      <div data-allocation-actions>
        <%= link_to budget_allocations_path(@budget), role: "button", aria: { label: t(".back") }, data: { intent: "secondary" } do %>
          <%= icon("chevron-left") %>
          <span><%= t(".back_name") %></span>
        <% end %>

        <% unless @allocation.deleted? %>
          <% if @allocation.finished? %>
            <% unless @budget.archived? %>
              <%= button_to reopen_allocation_path(@allocation), method: :patch,
                    data: { turbo_confirm: t(".reopen_confirmation", name: @allocation.name) } do %>
                <span><%= t(".reopen") %></span>
              <% end %>
            <% end %>
          <% else %>
            <% if @allocation.planned? %>
              <%= button_to finish_allocation_path(@allocation), method: :patch, data: {
                    intent: "primary",
                    turbo_confirm: t(".finish_confirmation", name: @allocation.name, amount: formatted_amount(@allocation.remaining_amount, @allocation.currency_code))
                  } do %>
                <span><%= t(".finish") %></span>
              <% end %>
            <% end %>

            <%= button_to allocation_path(@allocation), method: :delete, aria: { label: t(".remove") }, data: { intent: "secondary", turbo_confirm: t(".remove_confirmation") } do %>
              <%= icon("trash-simple") %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <% if @expenses.any? %>
        <article
          data-elevation="1"
          class="expense-list"
          data-testid="expense-list"
        >
          <h2><%= t(".expenses") %></h2>

          <main>
            <% @expenses_by_date.each do |date, expenses| %>
              <section data-expense-day data-testid="expense-day">
                <header>
                  <h3>
                    <time datetime="<%= date.iso8601 %>"><%= l(date, format: :long) %></time>
                  </h3>

                  <p>
                    <strong data-testid="expense-day-total">
                      <%= formatted_amount(@expense_totals_by_date.fetch(date), @allocation.currency_code) %>
                      <%= @allocation.currency_code %>
                    </strong>
                  </p>
                </header>

                <main>
                  <%= render expenses %>
                </main>
              </section>
            <% end %>
          </main>

          <%= render "shared/pagination", page: @page, records_name: t(".expense_records") %>
        </article>
      <% end %>
    </main>
  </article>
</main>
