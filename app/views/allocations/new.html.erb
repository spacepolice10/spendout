<main data-size="sm">
  <article data-elevation="1">
    <header>
      <nav>
        <%= link_to icon_tag("chevron-left"), budget_allocations_path(@budget), aria: { label: "Back to allocations" } %>
        <h1>New allocation</h1>
      </nav>
    </header>

    <main>
      <% if @active_sources.any? %>
        <%= render "form", budget: @budget, allocation: @allocation, active_sources: @active_sources %>
      <% else %>
        <h2>Add a source first</h2>
        <p>An allocation needs an active source.</p>
        <%= link_to "New source", new_budget_source_path(@budget) %>
      <% end %>
    </main>
  </article>
</main>
