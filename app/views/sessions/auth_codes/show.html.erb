<main data-size="sm">
  <article data-elevation="1">
    <header>
      <h1>Enter your sign-in code</h1>
    </header>

    <main>
      <p>
        We sent a six-character code to
        <%= session[:email_address_pending_authentication] %>.
      </p>

      <%= form_with url: session_auth_code_path do |form| %>
        <%= form.label :code, "Sign-in code" %>
        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "text", maxlength: 7 %>
        <%= form.button "Sign in", type: "submit", data: { intent: "primary", size: "lg" } %>
      <% end %>
    </main>

    <footer>
      <%= link_to "Use another email address", new_session_path, style: "text-decoration: underline;" %>
    </footer>
  </article>
</main>
