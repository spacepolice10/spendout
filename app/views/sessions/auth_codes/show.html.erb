<main class="session-page" data-size="sm">
  <header>
    <aside data-cybercat-answer>
      <%= image_tag "cybercat.png", alt: t(".cybercat_description"), width: 40, height: 40 %>
      <p><%= t(".instructions", count: AuthCode::CODE_LENGTH, address: session[:email_address_pending_authentication]) %></p>
    </aside>
  </header>

  <article data-elevation="1">
    <header>
      <h1><%= t(".name") %></h1>
    </header>

    <main>
      <%= form_with url: session_auth_code_path do |form| %>
        <%= form.text_field :code, required: true, autofocus: !mobile_variant?, placeholder: t(".code_placeholder"), autocomplete: "one-time-code", inputmode: "text", maxlength: 7 %>
        <%= form.button type: "submit", data: { appearance: "keycap", intent: "primary" } do %>
          <span><%= t(".submit") %></span>
          <%= icon("chevron-right") %>
        <% end %>
      <% end %>
    </main>

    <footer>
      <%= link_to t(".type_another_address"), new_session_path, style: "text-decoration: underline;" %>
    </footer>
  </article>
</main>
