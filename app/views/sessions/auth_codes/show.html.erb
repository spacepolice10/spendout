<main data-size="sm">
  <article data-elevation="1">
    <header>
      <h1>Enter your sign-in code</h1>
    </header>

    <main>
      <p>
        We sent a six-character code to
        <%= session[:email_address_pending_authentication] %>.
      </p>

      <%= form_with url: session_auth_code_path do |form| %>
        <%= form.text_field :code, required: true, autofocus: !mobile_variant?, placeholder: "123456", autocomplete: "one-time-code", inputmode: "text", maxlength: 7 %>
        <%= form.button type: "submit", data: { appearance: "keycap", intent: "primary" } do %>
          <span>Sign in</span>
          <%= icon_tag("chevron-right") %>
        <% end %>
      <% end %>
    </main>

    <footer>
      <%= link_to "Use another email address", new_session_path, style: "text-decoration: underline;" %>
    </footer>
  </article>
</main>
