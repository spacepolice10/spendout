<main data-size="sm">
  <article data-elevation="1">
    <header>
      <h1><%= t(".title") %></h1>
    </header>

    <main>
      <p><%= t(".instructions", count: AuthCode::CODE_LENGTH, email_address: session[:email_address_pending_authentication]) %></p>

      <%= form_with url: session_auth_code_path do |form| %>
        <%= form.text_field :code, required: true, autofocus: !mobile_variant?, placeholder: t(".code_placeholder"), autocomplete: "one-time-code", inputmode: "text", maxlength: 7 %>
        <%= form.button type: "submit", data: { appearance: "keycap", intent: "primary" } do %>
          <span><%= t(".submit") %></span>
          <%= icon("chevron-right") %>
        <% end %>
      <% end %>
    </main>

    <footer>
      <%= link_to t(".use_another_email"), new_session_path, style: "text-decoration: underline;" %>
    </footer>
  </article>
</main>
