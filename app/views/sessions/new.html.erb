<main class="session-page" data-size="sm">
  <header>
    <%= image_tag "cybercat.png", alt: "Cybercat", width: 100 %>
    <h1>Spendout</h1>
    <p>Spendout is a simple and secure way to manage your money.</p>
  </header>

  <article data-elevation="1">
    <header>
      <h2>Sign in</h2>
    </header>

    <main>
      <p>Use your password, or ask for a six-character sign-in code.</p>

      <%= form_with url: session_path do |form| %>
        <label>
          Email address
          <%= form.email_field :email_address, required: true, autofocus: !mobile_variant?, autocomplete: "email", placeholder: "you@example.com", value: params[:email_address] %>
        </label>

        <label>
          Password
          <%= form.password_field :password, autocomplete: "current-password" %>
        </label>

        <%= form.button type: "submit", name: "authentication_method", value: "password", data: { appearance: "keycap", intent: "primary" } do %>
          <span>Sign in with password</span>
          <%= icon_tag("chevron-right") %>
        <% end %>

        <%= form.button type: "submit", name: "authentication_method", value: "code" do %>
          <span>Email me a code</span>
          <%= icon_tag("chevron-right") %>
        <% end %>
      <% end %>
    </main>
  </article>
</main>
