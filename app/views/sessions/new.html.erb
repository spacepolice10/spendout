<main class="session-page" data-size="sm">
  <header>
    <aside data-cybercat-answer>
      <%= image_tag "cybercat.png", alt: t(".logo_description"), width: 40, height: 40 %>
      <p><%= t(".tagline") %></p>
    </aside>
  </header>

  <article data-elevation="1">
    <header>
      <h2><%= t(".name") %></h2>
    </header>

    <main>
      <p><%= t(".instructions", count: AuthCode::CODE_LENGTH) %></p>

      <%= form_with url: session_path do |form| %>
        <%= form.email_field :email_address, required: true, autofocus: !mobile_variant?, autocomplete: "email", placeholder: t(".address_placeholder"), value: params[:email_address] %>

        <%= form.button type: "submit", data: { appearance: "keycap", intent: "primary" } do %>
          <span><%= t(".submit") %></span>
          <%= icon("chevron-right") %>
        <% end %>
      <% end %>
    </main>
  </article>

  <%= render "shared/locale_switcher" %>
</main>
