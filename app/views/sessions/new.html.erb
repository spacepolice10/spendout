<main class="session-page" data-size="sm">
  <header>
    <h1>Spendout</h1>
  </header>

  <article data-elevation="1">
    <header>
      <h2>Sign in</h2>
    </header>

    <main>
      <p>We’ll email you a six-character sign-in code.</p>

      <%= form_with url: session_path do |form| %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", value: params[:email_address] %>
        <%= form.button "Email me a code", type: "submit", data: { intent: "primary" } %>
      <% end %>
    </main>
  </article>
</main>
