<main class="session-page" data-size="sm">
  <header>
    <%= image_tag "cybercat.png", alt: t(".logo_alt"), width: 100 %>
    <h1><%= t(".product_name") %></h1>
    <p><%= t(".tagline") %></p>
  </header>

  <article data-elevation="1">
    <header>
      <h2><%= t(".title") %></h2>
    </header>

    <main>
      <p><%= t(".instructions", count: AuthCode::CODE_LENGTH) %></p>

      <%= form_with url: session_path do |form| %>
        <%= form.email_field :email_address, required: true, autofocus: !mobile_variant?, autocomplete: "email", placeholder: t(".email_placeholder"), value: params[:email_address] %>

        <%= form.button type: "submit", data: { appearance: "keycap", intent: "primary" } do %>
          <span><%= t(".submit") %></span>
          <%= icon("chevron-right") %>
        <% end %>
      <% end %>
    </main>
  </article>
</main>
