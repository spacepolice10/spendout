<%= form_with model: budget, data: { budget_form: true } do |form| %>
  <% if budget.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(budget.errors.count, "error") %> prevented this budget
        from being saved:
      </h2>

      <ul>
        <% budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <fieldset class="salary" data-layout="grid">
    <legend>What's your salary?</legend>
    <small>Or how much do you expect to earn/spend in this budget?</small>
    <div>
      <%= form.label :source_amount, "Amount", hidden: true %>

      <%= form.text_field :source_amount, inputmode: "decimal", placeholder: "0", required: true, autofocus: true,
              aria: { label: "Enter your salary amount" },
              data: {
                controller: "money-input",
                money_input_start_value: budget.source_amount&.to_s("F")
              } %>

      <%= form.label :currency_code, "Currency", hidden: true %>
      <%= form.select :currency_code, Currency.options,
            { include_blank: "Choose a currency" },
            required: true, aria: { label: "Choose your salary currency" } %>
      <%= form.hidden_field :source_rate, value: 1 %>
    </div>
  </fieldset>

  <fieldset data-layout="flex">
    <legend>How often do you get paid?</legend>
    <small>Or how often do you expect to replenish your budget?</small>
    <div>
      <%= form.collection_radio_buttons :duration, Budget::DURATIONS.keys, :itself, ->(value) { value.tr("_", " ") } do |radio| %>
        <%= radio.label { radio.radio_button + radio.text } %>
      <% end %>
    </div>
  </fieldset>

  <%= tag.details do %>
    <summary>
      <span>
        <%= icon_tag("plus") %>
        Date
      </span>
      <small>
          Starts today by default
      </small>
    </summary>

    <div>
      <%= form.date_field :period_from, required: true %>
    </div>
  <% end %>

  <br>
  <%= form.button "Create budget", type: "submit", data: { intent: "primary" } %>
<% end %>
