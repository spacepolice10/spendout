<%= form_with model: budget, data: { budget_form: true } do |form| %>
  <% if budget.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(budget.errors.count, "error") %> prevented this budget
        from being saved:
      </h2>

      <ul>
        <% budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <label for="base_currency_code">
    <legend>What's your main currency?</legend>
    <small>Other currencies will use this one as a reference to calculate against to.</small>

    <div>
      <%= form.select :base_currency_code, Currency.options,
            { include_blank: "Choose a currency" },
            required: true, autofocus: true, aria: { label: "Choose your main currency" } %>
    </div>
  </label>

  <!-- <fieldset data-layout="flex"> -->
    <!-- <legend>How often do you get paid?</legend> -->
    <!-- <small>Or how often do you expect to replenish your budget?</small> -->

    <!-- <div> -->
      <%#= form.collection_radio_buttons :duration, Budget::DURATIONS.keys, :itself, ->(value) { value.tr("_", " ") } do |radio| %>
        <%#= radio.label { radio.radio_button + radio.text } %>
      <%# end %>
    <!-- </div> -->
  <!-- </fieldset> -->

  <fieldset data-layout="flex">
    <legend>When does your budget start and end?</legend>
    <small>Mostly people select a period in 1 month between the paydays</small>

    <div style="flex-wrap: nowrap;">
      <%= form.date_field :period_from, value: Date.today.beginning_of_month, required: true %>
      <%= form.date_field :period_to, value: Date.today.end_of_month, required: true %>
    </div>
  </fieldset>

  <%#= tag.details do %>
    <!-- <summary> -->
      <!-- <span> Starts at </span> -->
      <!-- <small> Begging of the month </small> -->
    <!-- </summary> -->

    <!-- <div> -->
      <%#= form.date_field :period_from, value: Date.today.beginning_of_month, required: true %>
    <!-- </div> -->
  <%# end %>

  <br>

  <%= form.button type: "submit", data: { intent: "primary" } do %>
    Next step <%= icon_tag("chevron-right") %>
  <% end %>
<% end %>
