<%= form_with model: budget, data: {
      budget_form: true,
      controller: "form",
      form_focused_on_toggle_value: !mobile_variant?
    } do |form| %>
  <% if budget.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= t(".errors", count: budget.errors.count) %>
      </h2>

      <ul>
        <% budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <label for="base_currency_code">
    <legend><%= t(".base_currency.name") %></legend>
    <small><%= t(".base_currency.description") %></small>

    <div>
      <%= render "shared/currency_picker", form: form, attribute: :base_currency_code,
            filter_autofocus: true %>
    </div>
  </label>

  <fieldset data-layout="flex">
    <legend><%= t(".period.name") %></legend>
    <small><%= t(".period.description") %></small>

    <div>
      <%= form.date_field :starts_date, value: Date.today.beginning_of_month, required: true %>
      <%= form.date_field :ends_date, value: Date.today.end_of_month, required: true %>
    </div>
  </fieldset>

  <br>

  <%= form.button type: "submit", data: { appearance: "keycap", intent: "primary" } do %>
    <%= t(".submit") %> <%= icon("chevron-right") %>
  <% end %>
<% end %>
