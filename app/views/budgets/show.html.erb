<main class="budget-page" data-size="sm">
  <header>
    <nav>
      <%= link_to icon_tag("chevron-left"), budgets_path, aria: { label: "Back to budgets" } %>
      <h1><%= @budget.name %></h1>
    </nav>
  </header>

  <%= tag.p(flash[:notice]) if flash[:notice] %>

  <article class="budget" data-elevation="1" data-archived="<%= @budget.archived? %>" data-testid="budget-card">
    <header>
      <h2>Budget details</h2>
      <small><%= "Archived" if @budget.archived? %></small>
    </header>
    <main>
      <% source = @budget.base_source %>
      <dl>
        <dt>Remaining</dt>
        <dd><%= formatted_amount(@budget.amount_summary, @budget.base_currency) %> <%= @budget.base_currency.alphabetic_code %></dd>
        <dt>Available</dt>
        <dd><%= formatted_amount(@budget.available_summary, @budget.base_currency) %> <%= @budget.base_currency.alphabetic_code %></dd>
        <% if @budget.todays_remainder %>
          <dt>Today's remainder</dt>
          <dd><%= formatted_amount(@budget.todays_remainder, @budget.base_currency) %> <%= @budget.base_currency.alphabetic_code %></dd>
        <% end %>
        <dt>Starting amount</dt>
        <dd><%= formatted_amount(source.amount, source.currency) %> <%= source.currency.alphabetic_code %></dd>
        <dt>Period</dt>
        <dd><%= @budget.period_from.to_fs(:long) %> – <%= @budget.period_to.to_fs(:long) %></dd>
      </dl>
      <% if @budget.overallocated? %>
        <p role="status" data-testid="overallocation-warning">
          Planned allocations exceed available sources by
          <%= formatted_amount(@budget.overallocated_by, @budget.base_currency) %>
          <%= @budget.base_currency.alphabetic_code %>.
        </p>
      <% end %>
    </main>
    <footer>
      <%= link_to "Sources", budget_sources_path(@budget), role: "button" %>
      <%= link_to "Allocations", budget_allocations_path(@budget), role: "button" %>
      <%= link_to "Currencies", budget_currencies_path(@budget), role: "button" %>
      <%= button_to "Delete budget", budget_path(@budget), method: :delete,
            data: { intent: "negative", turbo_confirm: "Delete this budget and its source permanently?" } %>
    </footer>
  </article>

  <article data-elevation="1" data-testid="expense-list">
    <header>
      <h2>Expenses</h2>
    </header>

    <main>
      <% if @expenses.any? %>
        <%= render @expenses %>
      <% else %>
        <h3>No expenses yet</h3>
        <p>Add an expense to track spending from this budget.</p>
      <% end %>
    </main>

    <footer>
      <%= link_to "New expense", new_budget_expense_path(@budget), role: "button" %>
    </footer>
  </article>
</main>
