<main data-size="sm">
  <%= tag.p(flash[:notice]) if flash[:notice] %>

  <article
    class="budget"
    data-elevation="1"
    data-archived="<%= @budget.archived? %>"
    data-testid="budget-card"
  >
    <header>
      <nav>
        <h3>Hello, <%= current_user.email_address %></h3>
      </nav>

      <small><%= "Archived" if @budget.archived? %></small>
    </header>

    <main>
      <% if (todays_remainder = @budget.todays_remainder) %>
        <% remainder_percentage = @budget.todays_remainder_percentage.to_f.round(2) %>
        <div
          role="progressbar"
          aria-label="Daily budget health"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="<%= remainder_percentage %>"
          aria-valuetext="<%= remainder_percentage %>% of the daily target"
          data-remainder-progress
          style="--remainder-percentage: <%= remainder_percentage %>%;"
        >
          <span data-remainder-progress-fill></span>
        </div>

        <dl>
          <dt>Today's remainder</dt>

          <dd>
            <h2>
              <%= formatted_amount(todays_remainder, @budget.base_currency) %> <%= @budget.base_currency.alphabetic_code %>
            </h2>
          </dd>
        </dl>
      <% end %>
    </main>

    <footer>
      <%= link_to budget_sources_path(@budget), role: "button", class: "source-button",
            data: { appearance: "keycap", colour: "green" } do %>
        <%= icon_tag("wallet") %>
        <span>Money</span>
      <% end %>
      <%= link_to budget_allocations_path(@budget), role: "button", class: "allocation-button",
            data: { appearance: "keycap", colour: "pink" } do %>
        <%= icon_tag("pig-money") %>
        <span>Plan</span>
      <% end %>
      <%= link_to budget_currencies_path(@budget), role: "button", class: "currency-button",
            data: { appearance: "keycap", colour: "yellow" } do %>
        <%= icon_tag("coin") %>
        <span>Currencies</span>
      <% end %>
    </footer>
  </article>

  <article class="expense-list" data-elevation="1" data-testid="expense-list">
    <header>
      <h2>Expenses</h2>
    </header>

    <main>
      <% if @expenses.any? %>
        <%= render @expenses %>
      <% else %>
        <p>Add an expense to track spending from this budget.</p>
      <% end %>
    </main>

    <footer>
      <%= link_to new_budget_expense_path(@budget),
            role: "button",
            data: { intent: "primary", create_expense: true },
            aria: { label: "New expense" } do %>
              <%= icon_tag("plus") %>
              <span>New expense</span>
            <% end %>
    </footer>
  </article>
</main>
