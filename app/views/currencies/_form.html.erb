<%= form_with model: currency.persisted? ? currency : [ budget, currency ] do |form| %>
  <% if currency.errors.any? %>
    <section role="alert" data-form-errors>
      <h2>
        <%= pluralize(currency.errors.count, "error") %> prevented this currency
        from being saved:
      </h2>

      <ul>
        <% currency.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if currency.persisted? %>
    <p><strong><%= currency.option_name %></strong></p>
  <% else %>
    <%= form.label :alphabetic_code, "Currency" %>
    <%= form.select :alphabetic_code, currency_options,
          { include_blank: "Choose a currency" }, required: true %>
  <% end %>

  <%= form.label :rate, "Rate" %>
  <%= form.number_field :rate, min: 0, step: :any, required: true, autofocus: currency.persisted? %>

  <p>
    Rate is expressed as base-currency units per one unit.
    <% if currency.alphabetic_code.present? %>
      For example, 1 <%= currency.alphabetic_code %> = <%= currency.rate.presence || "…" %> <%= budget.base_currency.alphabetic_code %>.
    <% else %>
      For example, 1 foreign unit = 1.10 <%= budget.base_currency.alphabetic_code %>.
    <% end %>
  </p>

  <%= form.submit currency.persisted? ? "Update rate" : "Add currency" %>
<% end %>
