<main data-size="sm">
  <article data-elevation="1">
    <header>
      <nav>
        <%= link_to icon_tag("chevron-left"), budget_currencies_path(@budget), aria: { label: "Back to currencies" } %>
        <h1>New currency</h1>
      </nav>
    </header>

    <main>
      <% if @currency_options.any? %>
        <%= render "form", budget: @budget, currency: @currency, currency_options: @currency_options %>
      <% else %>
        <p>Every supported currency has already been added.</p>
      <% end %>
    </main>
  </article>
</main>
